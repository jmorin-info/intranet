# ============================================================================
# OMNITECH Intranet — Production Environment Variables (template)
# Copier vers .env.prod et remplir les valeurs reelles.
# Les SECRETS (mots de passe, cles privees, JWT) sont stockes dans
# ./secrets/*.txt et JAMAIS dans .env.prod (cf DOCKER_COMPOSE_PROD.md).
# NE JAMAIS commiter .env.prod ni le repertoire ./secrets/ !
# ============================================================================

# === Application ===
NODE_ENV=production
APP_NAME="OMNITECH Intranet"
APP_URL=https://intranet.omnitech-security.fr
PORT=3000
HOST=0.0.0.0
IMAGE_TAG=latest

# === PostgreSQL — utilisateur + DB (mot de passe via Docker secret) ===
POSTGRES_USER=omnitech
POSTGRES_DB=omnitech_intranet

# === Redis — config (mot de passe via Docker secret) ===
REDIS_HOST=redis
REDIS_PORT=6379

# === JWT (secrets via Docker secret) ===
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === Rate limiting ===
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# === HaveIBeenPwned (ANSSI R20) ===
HIBP_ENABLED=true
HIBP_THRESHOLD=100

# === SMTP (mot de passe SMTP recommande aussi en secret) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme_to_docker_secret_in_real_prod
SMTP_FROM="OMNITECH Intranet <noreply@example.com>"

# === Storage local ===
STORAGE_PATH=/app/storage
STORAGE_SECRET=changeme_random_string_for_signed_urls_use_openssl_rand
UPLOAD_MAX_SIZE_MB=50

# === DocuSeal (signatures) ===
DOCUSEAL_URL=https://docuseal.intranet.omnitech-security.fr
DOCUSEAL_API_URL=http://docuseal:3000/api
DOCUSEAL_API_KEY=changeme_to_docker_secret_in_real_prod
DOCUSEAL_WEBHOOK_SECRET=changeme_to_docker_secret_in_real_prod
DOCUSEAL_WEBHOOK_SECRET_HMAC_MODE=true
DOCUSEAL_TEMPLATE_ID=1

# === SMB / fileserver ===
FILESERVER_HOST=10.33.50.5
FILESERVER_USER=svc_intranet@example.local
FILESERVER_SERVICE_PASSWORD=changeme_to_docker_secret_in_real_prod
FILESERVER_PASSWORD=changeme_to_docker_secret_in_real_prod

# === Web Push (VAPID — generer avec scripts/generate-vapid.sh) ===
VAPID_PUBLIC_KEY=BNa_PLACEHOLDER_PUBLIC_KEY_REPLACE_WITH_REAL_VALUE
VAPID_PRIVATE_KEY=PLACEHOLDER_PRIVATE_KEY_REPLACE_WITH_REAL_VALUE
VAPID_SUBJECT=mailto:noc@omnitech-security.fr

# === CORS ===
CORS_ORIGINS=https://intranet.omnitech-security.fr

# === Reverse proxy (nginx/BunkerWeb) ===
TRUST_PROXY=loopback, linklocal, uniquelocal
DOCKER_BIND_IP=0.0.0.0

# === Frontend (NEXT_PUBLIC_* — exposes dans le bundle browser) ===
NEXT_PUBLIC_API_URL=https://intranet.omnitech-security.fr/api
NEXT_PUBLIC_APP_NAME="OMNITECH Intranet"
NEXT_PUBLIC_WS_URL=wss://intranet.omnitech-security.fr
NEXT_PUBLIC_DOCUSEAL_URL=https://docuseal.intranet.omnitech-security.fr

# === Logging ===
LOG_LEVEL=info

# === Sentry (opt-in) ===
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_REPLAY_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# === OnlyOffice (JWT via Docker secret) ===
ONLYOFFICE_ENABLED=true
ONLYOFFICE_DOCUMENT_SERVER_URL=https://intranet.omnitech-security.fr/onlyoffice
ONLYOFFICE_INTERNAL_URL=http://documentserver

# === Stirling PDF ===
STIRLING_PDF_ENABLED=true
STIRLING_PDF_URL=http://stirling-pdf:8080

# === Retention (ISO 27001 A.5.33) ===
RETENTION_DOC_ARCHIVE_DAYS=1095
RETENTION_DOC_DELETE_DAYS=2555
RETENTION_AUDIT_KEEP_DAYS=1825
RETENTION_AUTO_APPLY=false

# === RAG / chatbot ===
RAG_ENABLED=true
RBAC_RAG_ENABLED=true
CHATBOT_UNIFIED_ENABLED=false

# === Ollama ===
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2:0.5b
OLLAMA_ENABLED=true

# === Access reviews ===
ACCESS_REVIEW_AUTO_INACTIVE=false
PASSWORD_ROTATION_MONTHS=6

# === Watchtower (optionnel) ===
# WATCHTOWER_NOTIFICATION_URL=slack://hook?token=xxx&channel=ops
WATCHTOWER_NOTIFICATION_URL=

# === Chromatic CI (Storybook visual regression) ===
# Token a recuperer sur https://www.chromatic.com/manage?appId=<projet>
# Stocke dans GH Actions secrets : settings > secrets > actions > CHROMATIC_PROJECT_TOKEN
CHROMATIC_PROJECT_TOKEN=

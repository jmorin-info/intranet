IS_DRAFT=no
SERVER_NAME=intranet.omnitech-security.fr

# ---------------------------------------------------------------
# Sécurité générale
# ---------------------------------------------------------------
SECURITY_MODE=detect
USE_CLIENT_CACHE=yes

# Listes communautaires (IP malveillantes + User-Agents connus)
BLACKLIST_COMMUNITY_LISTS=ip:laurent-minne-data-shield-aggressive ip:danmeuk-tor-exit ua:mitchellkrogza-bad-user-agents

# ---------------------------------------------------------------
# Géo-filtrage
# ---------------------------------------------------------------
# Quand WHITELIST_COUNTRY est défini, tout pays absent de la liste
# est automatiquement bloqué → BLACKLIST_COUNTRY devient redondant.
# Code ISO du Royaume-Uni = GB (pas UK).
# Ajoute BE/LU/NL/PT si tes utilisateurs voyagent dans ces pays.
WHITELIST_COUNTRY=FR US IT GB DE ES

# ---------------------------------------------------------------
# Certificats TLS
# ---------------------------------------------------------------
USE_CUSTOM_SSL=yes
CUSTOM_SSL_CERT=/etc/ssl/bunkerweb.crt
CUSTOM_SSL_KEY=/etc/ssl/bunkerweb.key
AUTO_LETS_ENCRYPT=yes
EMAIL_LETS_ENCRYPT=rssi@omnitech-security.fr
REDIRECT_HTTP_TO_HTTPS=yes

# ---------------------------------------------------------------
# Anti-DoS / WAF
# ---------------------------------------------------------------
# À activer en production une fois les seuils calibrés.
USE_LIMIT_REQ=no
USE_LIMIT_CONN=no
USE_MODSECURITY=no

# ---------------------------------------------------------------
# Taille des corps de requête
# ---------------------------------------------------------------
# Par défaut BunkerWeb limite à 10 Mo. L'intranet accepte des uploads
# de documents jusqu'à 50 Mo (ALLOWED_MIME_TYPES backend + validation
# magic-bytes). On aligne la limite ici pour autoriser les uploads de
# PDF/DOCX volumineux ainsi que les audio/vidéos éventuels.
MAX_CLIENT_SIZE=100m

# ---------------------------------------------------------------
# Anti-bot — à configurer si trafic bot suspect
# ---------------------------------------------------------------
# Désactive le challenge anti-bot sur les POST d'API (les clients
# authentifiés avec JWT ne sont pas des bots). Sans cette exclusion,
# les POST /api/v1/documents peuvent être bloqués en 400/403 par la
# détection bot comportementale.
USE_ANTIBOT=no

# ---------------------------------------------------------------
# Whitelist URI — bypass pour les endpoints API authentifiés
# ---------------------------------------------------------------
# Les endpoints ci-dessous contiennent des charges JSON ou multipart
# dont le contenu (HTML sanitisé, noms de fichiers, tokens) peut
# déclencher les signatures CRS (SQL injection, XSS) ou anti-bot.
# Ils sont protégés indépendamment par le JWT + les validations NestJS
# (class-validator, magic-bytes, RBAC). Le WAF sur ces routes est
# contre-productif (faux positifs > vraie protection).
WHITELIST_URI=^/api/v1/documents ^/api/v1/wiki ^/api/v1/tickets ^/api/v1/news ^/api/v1/chat/ ^/api/v1/office/callback ^/api/v1/chartes/.+/sign ^/api/v1/testimonials

# ---------------------------------------------------------------
# Real IP (important derrière un load balancer / firewall)
# ---------------------------------------------------------------
# ⚠ NE JAMAIS mettre 0.0.0.0/0 ici : n'importe qui pourrait alors
# spoofer son IP via l'en-tête X-Forwarded-For.
# Renseigne uniquement le(s) réseau(x) de tes proxys amont.
USE_REAL_IP=yes
REAL_IP_FROM=10.33.0.0/16

# ---------------------------------------------------------------
# Reverse proxy → stack Omnitech Intranet
# ---------------------------------------------------------------
# Frontend Next.js (racine)         → :3001
# Backend NestJS API                → :3000/api/
# WebSocket (socket.io notifs/chat) → :3000/socket.io/
# OnlyOffice Document Server        → :8082/onlyoffice/
USE_REVERSE_PROXY=yes

REVERSE_PROXY_HOST=http://10.33.120.55:3001
REVERSE_PROXY_WS=yes

REVERSE_PROXY_HOST_1=http://10.33.120.55:3000/api/
REVERSE_PROXY_URL_1=/api/
REVERSE_PROXY_WS_1=yes

REVERSE_PROXY_HOST_2=http://10.33.120.55:3000/socket.io/
REVERSE_PROXY_URL_2=/socket.io/
REVERSE_PROXY_WS_2=yes

REVERSE_PROXY_HOST_3=http://10.33.120.55:8082/
REVERSE_PROXY_URL_3=/onlyoffice/
REVERSE_PROXY_WS_3=yes

# ---------------------------------------------------------------
# Whitelist IP interne (réseau admin)
# ---------------------------------------------------------------
# /2 couvrait un quart d'Internet ; /24 correspond à un vrai LAN.
# Ajuste le masque à la taille réelle de ton sous-réseau.
WHITELIST_IP=10.33.10.0/24

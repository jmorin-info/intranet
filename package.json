{
  "name": "omnitech-intranet",
  "version": "1.0.0",
  "private": true,
  "description": "Intranet GED sécurisé OMNITECH Security — ISO 27001:2022",
  "scripts": {
    "test": "pnpm --filter @omnitech/backend exec jest --runInBand && pnpm --filter @omnitech/frontend test",
    "verify:maintenance": "bash scripts/verify-maintenance.sh",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "pnpm -r run typecheck",
    "verify": "pnpm db:generate && pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky || true",
    "db:generate": "pnpm --filter @omnitech/database generate",
    "db:push": "pnpm --filter @omnitech/database db:push",
    "db:migrate": "pnpm --filter @omnitech/database migrate:dev",
    "db:seed": "pnpm --filter @omnitech/database seed",
    "clean": "turbo clean && rm -rf node_modules",
    "test:e2e": "playwright test",
    "a11y": "pa11y-ci --config .pa11yci.json",
    "a11y:mobile": "pa11y-ci --config .pa11yci.mobile.json"
  },
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pa11y-ci": "^4.1.0",
    "prettier": "^3.8.3"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "2.0.8",
      "sharp": "0.35.5",
      "@xmldom/xmldom": "0.8.15",
      "uuid@<14.0.0": ">=14.0.0",
      "multer": "2.5.0",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "engine.io@>=6.0.0 <6.6.10": "6.6.10",
      "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "follow-redirects@>=1.0.0 <1.16.2": "1.16.2",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "svgo@>=4.0.0 <4.1.0": "4.1.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "tmp@>=0.2.0 <0.2.7": "0.2.7",
      "qs@>=6.0.0 <6.16.1": "6.16.1",
      "@babel/core@>=7.0.0 <7.29.6": "7.29.6",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6"
    }
  }
}

# ─── Dépendances + builds ───────────────────────────────────────────────
node_modules/
dist/
.next/
.turbo/
.swc/
*.tsbuildinfo

# ─── Variables d'environnement ──────────────────────────────────────────
# Tous les .env sont ignorés SAUF *.example (templates non-secrets)
.env
.env.local
.env.production
.env.prod
.env.development
.env.test
.env.*.local
# Backups et anciennes versions d'env (NEVER commit — un backup .env
# contient les VRAIS secrets, même s'il est nommé .bak/.old/.backup)
.env.*backup*
.env.*.bak
# Variante où .bak est au milieu du nom, pas en suffixe (ex: .env.bak.cutover.<timestamp>)
.env.bak.*
.env*.bak.*
.env.*.old
.env.before-*
.env.pre-*
*-env.txt

# ─── Secrets divers ──────────────────────────────────────────────────────
# VAPID keys (Web Push)
vapid-keys.txt
vapid-keys.json
# Docker secrets (générés par init-secrets.sh)
secrets/*.txt
# Clés cryptographiques
*.key
*.pem
*.p12
*.pfx
*.crt
# Fichiers d'audit / scans qui peuvent contenir des credentials
*-scan.json
*-audit.json
gitleaks-report.*
trufflehog-report.*

# ─── Données utilisateurs / uploads ─────────────────────────────────────
uploads/
storage/
# Le pattern `storage/` ci-dessus, trop large, excluait par erreur le module
# source `apps/backend/src/storage/` (controller + service + module Nest) —
# la prod tournait avec ce module présent localement mais ABSENT de git, donc
# un clone neuf ne compilait pas le backend. On le réintègre explicitement.
!apps/backend/src/storage/
!apps/backend/src/storage/**

# ─── Logs ───────────────────────────────────────────────────────────────
*.log
logs/

# ─── Tests + couverture ────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Playwright ─────────────────────────────────────────────────────────
e2e/.auth/
playwright-report/
test-results/
apps/frontend/.next-ui-qa/

# ─── Storybook + Chromatic ──────────────────────────────────────────────
storybook-static/
chromatic-report.json
build-storybook.log

# ─── Outils dev (transcripts, sessions IDE, IA) ────────────────────────
.claude
.cursor
.aider*
# Transcripts d'assistants IA copiés par mégarde (Claude Code, Copilot)
# — souvent gros et contiennent du contexte sensible
*-claude-*.txt
*-claude-*.md
# Format de date ISO en début de nom — exemple type qui a déjà leaké
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# ─── OS / éditeurs ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml

# ─── Divers ─────────────────────────────────────────────────────────────
*.tmp
*.temp
.cache/
.parcel-cache/

# Registre SMSI en clair — ne pas versionner sur le remote
packages/database/prisma/reg016/registre.tsv

# Symlinks node_modules des worktrees (gitignore "node_modules/" ne matche pas un lien)
node_modules

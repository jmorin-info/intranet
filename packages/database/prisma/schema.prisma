  fileName     String
  originalName String
  filePath     String // Chemin relatif dans le storage
  fileSize     Int
  mimeType     String?
  description  String?
  uploadedById String
  reportPeriod String? // 'monthly', '2026-01', 'Q1-2026', etc.
  tags         String[]  @default([])
  metadata     Json?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  uploadedBy User @relation("ItExportUploader", fields: [uploadedById], references: [id])

  @@index([category, createdAt])
  @@index([uploadedById])
  @@index([deletedAt])
}

// =============================================================================
// Incidents — ISO 27001 A.5.24 (planification), A.5.25 (évaluation),
// A.5.26 (réponse), A.5.27 (tirer les enseignements).
// =============================================================================

model Incident {
  id              String           @id @default(uuid())
  reference       String           @unique // INC-2026-001
  title           String
  description     String
  category        IncidentCategory
  severity        IncidentSeverity
  status          IncidentStatus   @default(DETECTED)
  detectedAt      DateTime         @default(now())
  containedAt     DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  reporterId      String?
  assignedToId    String?
  affectedSystems String[]         @default([])
  affectedUsers   Int              @default(0)
  impactSummary   String?
  rootCause       String?
  lessonsLearned  String?
  gdprNotifiable  Boolean          @default(false)
  cnilReported    Boolean          @default(false)
  cnilReportedAt  DateTime?
  tags            String[]         @default([])
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reporter     User?                   @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedTo   User?                   @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  remediations Remediation[]
  timeline     IncidentTimelineEntry[]

  @@index([status, severity])
  @@index([category])
  @@index([detectedAt])
  @@index([assignedToId])
  /// idx pour incidents.service.ts findAll : where.deletedAt=null + orderBy detectedAt desc (couvre la liste paginée)
  @@index([deletedAt, detectedAt])
  /// idx pour ACL collaborateur : where.OR={reporterId:user.id} combiné au filtre status (incidents.service.ts:172)
  @@index([reporterId, status])
  /// idx pour ACL agent : where.OR={assignedToId:user.id} combiné au filtre status (incidents.service.ts:172)
  @@index([assignedToId, status])
  /// idx pour dashboard : count critical+open récents (incidents.service.ts getDashboard:466,474)
  @@index([severity, status, detectedAt])
}

model Remediation {
  id            String    @id @default(uuid())
  incidentId    String
  title         String
  description   String?
  responsibleId String?
  dueDate       DateTime?
  completedAt   DateTime?
  status        String    @default("TODO") // TODO, IN_PROGRESS, DONE, BLOCKED, CANCELLED
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  evidence      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  responsible User?    @relation("RemediationResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([incidentId, status])
  @@index([responsibleId, status])
  @@index([dueDate])
}

model IncidentTimelineEntry {
  id         String   @id @default(uuid())
  incidentId String
  authorId   String?
  entryType  String // STATUS_CHANGE, COMMENT, ACTION, EVIDENCE
  content    String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User?    @relation("IncidentTimelineAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
}

/// Configuration per-module access rules by scope (global, department, role).
/// Enables admins to declaratively enable/disable modules for specific
/// departments or roles without code changes.
model SpaceAccessConfig {
  id         String   @id @default(uuid())
  module     String
  scopeType  String
  scopeValue String?
  enabled    Boolean  @default(true)
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([module, scopeType, scopeValue])
  @@index([module])
}

// =============================================================================
// Calendar Events (custom events, separate from news/compliance/docs)
// =============================================================================

model CalendarEvent {
  id           String    @id @default(uuid())
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  allDay       Boolean   @default(false)
  category     String    @default("GENERAL") // AUDIT, FORMATION, COMITE, REUNION, MAINTENANCE, GENERAL
  location     String?
  createdById  String
  departmentId String?
  isRecurring  Boolean   @default(false)
  recurrence   String? // iCalendar RRULE format (FREQ=WEEKLY;BYDAY=MO,TU,...)
  color        String? // hex color for display
  // P1.10 — Calendrier individuel (synchro tickets) :
  //   userId    = utilisateur "propriétaire" de l'événement (ex. assigné ticket)
  //   sourceType / sourceId = clé fonctionnelle pour upsert idempotent
  //     (ex. sourceType=TICKET, sourceId=`<ticketId>:dueDate`)
  userId       String?
  sourceType   String?
  sourceId     String?
  // Multi-équipes / portée de visibilité (2026-04-26) :
  //   PRIVATE   : visible par le créateur uniquement
  //   TEAM      : visible par les membres du department lié (createdById ou departmentId)
  //   INTERNAL  : visible par tous les utilisateurs authentifiés (default)
  //   PUBLIC    : visible y compris par les utilisateurs externes/portail
  visibility   String     @default("INTERNAL")
  // Idempotence import iCal (RFC 5545 UID) — utilisé par /import et /sync
  // pour upsert sans dupliquer un évènement déjà importé. NULL pour les
  // events créés en interne (UID local = `<id>@omnitech-intranet`).
  externalUid  String?    @unique
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdBy  User        @relation("CalendarEventCreator", fields: [createdById], references: [id])
  user       User?       @relation("CalendarEventUser", fields: [userId], references: [id])
  department Department? @relation("CalendarEventDept", fields: [departmentId], references: [id])

  @@index([startDate, endDate])
  @@index([category])
  @@index([createdById])
  @@index([departmentId])
  @@index([userId, startDate])
  @@index([sourceType, sourceId])
  /// idx pour agenda départemental : events d'un département dans une fenêtre temporelle
  @@index([departmentId, startDate])
  /// idx pour filtrage visibility (queries getEventsForUser)
  @@index([visibility, startDate])
}

// =============================================================================
// Calendar Subscription Token — abonnement iCal (Outlook / Google) (P1.10)
// =============================================================================
// Permet à un utilisateur d'exposer son calendrier individuel via une URL
// publique signée par un token aléatoire (30 jours). Pas d'auth applicative
// sur l'endpoint d'export pour rester compatible Outlook "Ajouter calendrier
// > À partir d'Internet". Le token est révocable (delete) et expirable.
model CalendarSubscriptionToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  // Dernier hit sur l'endpoint d'export (audit / nettoyage tokens dormants)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation("CalendarSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =============================================================================
// Calendar Connection — sync bidirectionnel Google / Outlook (Wave B item 33)
// =============================================================================
// Tokens OAuth chiffrés au repos (AES-256-GCM, voir CryptoService).
// Un user peut avoir au plus une connexion par provider.
enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

model CalendarConnection {
  id              String           @id @default(uuid())
  userId          String
  provider        CalendarProvider
  // Token d'accès chiffré (préfixe "v1:" + IV + tag + ciphertext, base64)
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  // Identifiant du calendrier distant suivi (Google: calendarId, Outlook:
  // mailFolders/calendar id). NULL = calendrier "primary" / par défaut.
  calendarId      String?
  // Sync token Google (delta sync). Persisté pour accélérer les pulls
  // incrémentaux : on n'envoie que les events modifiés depuis le dernier sync.
  syncToken       String?
  // Outlook : delta link complet (https://...) pour Microsoft Graph delta query.
  deltaLink       String?
  syncEnabled     Boolean          @default(true)
  lastSyncAt      DateTime?
  // Compteur d'erreurs consécutives — au-delà de 5, on désactive auto la sync.
  syncErrorCount  Int              @default(0)
  lastErrorMsg    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation("CalendarConnectionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider, syncEnabled])
}

// =============================================================================
// WebDAV Token — sync bidirectionnel Obsidian via WebDAV (Wave B item 16)
// =============================================================================
// Token long-lived utilisé comme password Basic Auth par Obsidian Remotely Save.
// L'username Basic est l'email du user. Le token clair n'est JAMAIS persisté :
// seul `tokenHash` (sha256 hex) est stocké pour vérifier la valeur fournie.
model WebDAVToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  // Étiquette libre pour identifier le client (ex: "Obsidian iPhone")
  label      String?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation("WebDAVTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =============================================================================
// Saved Filters ("Mes vues")
// =============================================================================

model SavedFilter {
  id        String   @id @default(uuid())
  userId    String
  module    String // 'documents', 'tickets', 'incidents', 'news'
  name      String
  filters   Json // Les filtres sérialisés
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserSavedFilters", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
}


  token     String   @unique
  ownerId   String
  owner     User     @relation("ChatbotShareOwner", fields: [ownerId], references: [id])
  payload   Json // snapshot des messages (role, content, timestamp, sources)
  createdAt DateTime @default(now())
  expiresAt DateTime
  // Compteur de vues (analytics légère, non-PII)
  viewCount Int      @default(0)

  @@index([ownerId, createdAt])
  @@index([expiresAt])
}


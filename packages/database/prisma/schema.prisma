// =============================================================================
// Satisfaction Collaborateurs
// =============================================================================

model SatisfactionSurvey {
  id          String    @id @default(uuid())
  title       String
  description String?
  isActive    Boolean   @default(true)
  isAnonymous Boolean   @default(false)
  createdAt   DateTime  @default(now())

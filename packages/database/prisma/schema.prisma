// ============================================================
// RAG / AI Search (scaffold — nécessite pgvector)
// Ajouté le 2026-04-14 — à activer après install extension pgvector
// ============================================================

model RagChunk {
  id         String        @id @default(uuid())
  sourceType RagSourceType
  sourceId   String
  chunkIndex Int
  content    String        @db.Text
  tokenCount Int           @default(0)
  // Vector embedding (1024 dims pour Mistral Embed)
  // À activer après: CREATE EXTENSION vector; ALTER TABLE "RagChunk" ADD COLUMN embedding vector(1024);
  // Prisma ne supporte pas nativement pgvector : utiliser raw SQL pour les queries
  metadata   Json?
  indexedAt  DateTime      @default(now())

  @@index([sourceType, sourceId])
  @@index([indexedAt])
}

enum RagSourceType {
  DOCUMENT
  WIKI
  PROCEDURE
  RUNBOOK
  FAQ
  TICKET
}

model RagQueryLog {
  id         String   @id @default(uuid())
  userId     String
  query      String
  chunksUsed Int
  durationMs Int
  rating     Int? // -1 = negative, 0 = neutral, 1 = positive
  feedback   String? // Optional text feedback from user
  createdAt  DateTime @default(now())

  user User @relation("RagQueryAuthor", fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ============================================================
// RAG benchmark runs (Item 30 — fine-tuning corpus maison)
// Permet de tracker l'evolution des metriques du pipeline RAG
// au cours du temps : recall@5, MRR, faithfulness (LLM-judge),
// pour comparer reranker on/off, hybrid on/off, etc.
// ============================================================
model RagBenchmarkRun {
  id             String   @id @default(uuid())
  runAt          DateTime @default(now())
  // Version du dataset golden utilise (ex: "v1.0.0", "v1.1.0").
  datasetVersion String
  // Mode de retrieval evalue : "lexical" | "vector" | "hybrid" | "hybrid_alpha" | "rrf"
  mode           String
  // Recall@5 sur le golden set (0.0 - 1.0).
  recall5        Float
  // Mean Reciprocal Rank (0.0 - 1.0).
  mrr            Float
  // Faithfulness moyenne (LLM-judge, 0.0 - 1.0). Optional si pas evalue.
  faithfulness   Float?
  // Term coverage moyenne (0.0 - 1.0).
  termCoverage   Float?
  // Latence p50 / p95 (ms).
  latencyP50Ms   Int?
  latencyP95Ms   Int?
  // Nombre de questions executees.
  numQueries     Int
  // Nombre de chunks indexes au moment du run.
  numChunks      Int?
  // Configuration sterilisee (rerankerEnabled, queryExpansionN, hybridAlpha, etc.)
  config         Json?
  // Notes humaines optionnelles (changement teste, hypothese).
  notes          String?

  @@index([runAt])
  @@index([datasetVersion, mode])
}

// ============================================================
// Chat Unified Architecture (Mission 3 Phase 1) — 2026-04-20
// Gated by feature flag CHATBOT_UNIFIED_ENABLED (default false).
// Coexists with RagQueryLog until Phase 3 migration.
// ============================================================

enum ChatSurface {
  MODAL
  FAB
  AUTO
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum ChatFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum ChatFeedbackReason {
  WRONG_ANSWER
  MISSING_INFO
  OFF_TOPIC
  TOO_LONG
  TOO_SHORT
  HALLUCINATION
  OTHER
}

model ChatSession {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation("ChatSessionAuthor", fields: [userId], references: [id])
  title           String?
  surface         ChatSurface
  contextUrl      String?
  contextType     String?
  contextEntityId String?
  startedAt       DateTime      @default(now())
  lastMessageAt   DateTime      @default(now())
  archivedAt      DateTime?
  messages        ChatMessage[]

  @@index([userId, lastMessageAt])
  @@index([userId, archivedAt])
  @@index([surface, startedAt])
}

model ChatMessage {
  id                  String               @id @default(cuid())
  sessionId           String
  session             ChatSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role                ChatMessageRole
  content             String               @db.Text
  citations           Json?
  retrievalConfidence Float?
  retrievedChunkIds   String[]             @default([])
  modelUsed           String?
  modeUsed            String?
  tokensIn            Int?
  tokensOut           Int?
  timeToFirstTokenMs  Int?
  totalLatencyMs      Int?
  regenerateCount     Int                  @default(0)
  wasAborted          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  feedback            ChatMessageFeedback?

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model ChatMessageFeedback {
  id        String              @id @default(cuid())
  messageId String              @unique
  message   ChatMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation("ChatFeedbackAuthor", fields: [userId], references: [id])
  rating    ChatFeedbackRating
  reason    ChatFeedbackReason?
  comment   String?             @db.Text
  createdAt DateTime            @default(now())

  @@index([rating, createdAt])
}

// ============================================================
// Chatbot — partage de conversation (Feature 10, polish 2026-04-24)
// Crée un lien public éphémère (token UUID) vers une conversation
// snapshot read-only. Expire automatiquement après N jours (default 7).
// Aucun PII direct ici, mais on stocke ownerId pour audit ISO A.8.15.
// ============================================================
model ChatbotShareLink {

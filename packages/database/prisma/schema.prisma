enum SignatureCampaignSourceType {
  CHARTE
  DOCUMENT_POLICY
}

enum SignatureCampaignStatus {
  DRAFT
  SENT
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

model CampaignSignature {
  id                   String                  @id @default(uuid())
  campaignId           String
  userId               String
  docusealSubmissionId String?
  docusealSlug         String?
  status               CampaignSignatureStatus @default(PENDING)
  sentAt               DateTime?
  openedAt             DateTime?
  signedAt             DateTime?
  remindersSent        Int                     @default(0)
  lastReminderAt       DateTime?

  campaign SignatureCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User              @relation("SignatureRecipient", fields: [userId], references: [id])

  @@unique([campaignId, userId])
  @@index([userId, status])
  @@index([status])
}

enum CampaignSignatureStatus {
  PENDING
  OPENED
  SIGNED
  DECLINED
  EXPIRED

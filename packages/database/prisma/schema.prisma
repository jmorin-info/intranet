  user    User               @relation(fields: [userId], references: [id])
  answers QuestionAnswer[]

  @@unique([surveyId, userId])
}

model QuestionAnswer {
  id         String @id @default(uuid())
  responseId String
  questionId String
  value      String // The answer value (number for rating/scale, text for text, option label for choice)

  response SatisfactionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

// =============================================================================
// Chartes & Acceptation (ISO 27001 A.6.2)
// =============================================================================

model Charte {
  id                String   @id @default(uuid())
  title             String
  slug              String   @unique
  isMandatory       Boolean  @default(true)
  isActive          Boolean  @default(true)
  signedByDirection Boolean  @default(false)
  classification    String   @default("INTERNE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  versions   CharteVersion[]
  signatures CharteSignature[]
}

model CharteVersion {
  id            String    @id @default(uuid())
  charteId      String
  versionNumber String // "1.0", "1.1", "2.0"
  fileUrl       String // path to PDF in storage
  fileType      String    @default("application/pdf")
  fileSizeBytes Int
  checksum      String // SHA-256
  changeLog     String? // what changed in this version
  publishedAt   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  charte     Charte            @relation(fields: [charteId], references: [id], onDelete: Cascade)
  signatures CharteSignature[]

  @@index([charteId])
}

model CharteSignature {
  id              String   @id @default(uuid())
  charteId        String
  charteVersionId String
  userId          String
  signedAt        DateTime @default(now())
  ipAddress       String?
  userAgent       String?

  charte        Charte        @relation(fields: [charteId], references: [id], onDelete: Cascade)
  charteVersion CharteVersion @relation(fields: [charteVersionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@unique([charteId, charteVersionId, userId])
}

// =============================================================================

// ============================================================
// Workflow d'approbation configurable (ISO 27001 A.5.1)
// Ajouté le 2026-04-13 — scaffold, non encore utilisé par Document
// ============================================================

model ApprovalWorkflow {
  id               String            @id @default(uuid())
  name             String
  description      String?
  // Catégorie de doc pour laquelle ce workflow s'applique (null = tous)
  documentCategory DocumentCategory?
  isActive         Boolean           @default(true)
  isDefault        Boolean           @default(false) // un seul default par catégorie
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  createdBy User               @relation("WorkflowCreator", fields: [createdById], references: [id])
  steps     WorkflowStep[]
  instances ApprovalInstance[]

  @@index([documentCategory, isActive])
}

model WorkflowStep {
  id                   String           @id @default(uuid())
  workflowId           String
  order                Int // 1, 2, 3…
  name                 String // "Relecture juridique", "Validation RSSI", etc.
  // Mode : un seul approbateur OU plusieurs en parallèle OU plusieurs en série
  mode                 WorkflowStepMode @default(SINGLE)
  // Sélection des approbateurs : par rôle, par userId explicite, ou par département
  approverRole         UserRole?
  approverUserId       String?
  approverDeptId       String?
  // Délai max avant escalade
  slaHours             Int? // null = pas d'escalade auto
  escalateToUserId     String?
  // Autoriser le passage automatique si pas de réponse en SLA ?
  autoApproveOnTimeout Boolean          @default(false)
  // === Visual graph editor (item #24, 2026-04-26) ===
  // Type de noeud dans le graphe — APPROVAL est rétrocompatible (default).
  // BRANCH choisit une transition selon `condition`. PARALLEL_ALL / PARALLEL_ANY
  // peuvent aussi être encodés via `mode`, mais `type` permet à l'UI de
  // distinguer un noeud d'embranchement (multi sortie) d'un noeud d'approbation.
  type                 WorkflowStepType @default(APPROVAL)
  // Position visuelle dans le canvas (pixels). Servent uniquement à l'éditeur
  // — l'engine ignore ces champs.
  positionX            Int?
  positionY            Int?
  // Expression de condition (JSON) — évaluée sur le contexte de l'instance
  // pour les noeuds BRANCH ou les transitions conditionnelles.
  condition            Json?
  // Liste ordonnée d'IDs de prochains steps (texte simple : ids inclus dans
  // le même workflow). Utilisé par l'engine pour la traversée DAG. Si null /
  // vide → fallback sur `order + 1` (rétrocompat).
  nextStepIds          String[]         @default([])
  // Multi-niveaux (item #27) — seuil minimum d'approbations pour valider
  // une étape de type GROUP/PARALLEL. Default 1 (legacy SINGLE).
  minApprovers         Int              @default(1)

  workflow     ApprovalWorkflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverUser User?                  @relation("StepApprover", fields: [approverUserId], references: [id])
  approverDept Department?            @relation("StepDept", fields: [approverDeptId], references: [id])
  escalateTo   User?                  @relation("StepEscalate", fields: [escalateToUserId], references: [id])
  instances    ApprovalStepInstance[]

  @@unique([workflowId, order])
  @@index([workflowId])
  @@index([type])
}

enum WorkflowStepMode {
  SINGLE // un seul approbateur
  PARALLEL_ALL // N approbateurs, tous doivent valider
  PARALLEL_ANY // N approbateurs, le premier qui valide fait passer
}

/// Type de noeud dans le graphe DAG d'un workflow visuel (item #24).
/// - START / END : noeuds techniques (un seul START, ≥ 1 END par workflow).
/// - APPROVAL    : étape d'approbation classique (équivaut à mode SINGLE).
/// - BRANCH      : choisit une sortie selon `condition` évaluée sur le ctx.
/// - PARALLEL_ALL/ANY : étape parallèle (équivalent à mode mais explicite).
/// - DELEGATE    : étape qui force une délégation explicite (transmis à un
///                 autre user). Réservé pour usage avancé.
enum WorkflowStepType {
  START
  APPROVAL
  BRANCH
  PARALLEL_ALL
  PARALLEL_ANY
  DELEGATE
  END
}

model ApprovalInstance {
  id                String                 @id @default(uuid())
  workflowId        String
  documentId        String
  documentVersionId String
  currentStepOrder  Int                    @default(1)
  status            ApprovalInstanceStatus @default(PENDING)
  startedAt         DateTime               @default(now())
  completedAt       DateTime?
  startedById       String

  workflow    ApprovalWorkflow       @relation(fields: [workflowId], references: [id])
  startedBy   User                   @relation("InstanceStarter", fields: [startedById], references: [id])
  stepResults ApprovalStepInstance[]

  @@index([documentId])
  @@index([status])
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  TIMEOUT_ESCALATED
}

model ApprovalStepInstance {
  id           String           @id @default(uuid())
  instanceId   String
  stepId       String
  // Approbateur pré-assigné pour cette step-instance. Utilisé par les modes
  // PARALLEL_ALL / PARALLEL_ANY où l'on matérialise une ligne par approbateur
  // attendu. Null pour SINGLE basé sur rôle/département (résolution dynamique).
  assignedToId String?
  decidedById  String?
  decision     ApprovalDecision @default(PENDING)
  comment      String?
  decidedAt    DateTime?
  escalatedAt  DateTime?
  dueAt        DateTime?
  // Champs ajoutés 2026-04-26 — Approbation N+1 dynamique (WorkflowRule).
  // `level` représente le palier hiérarchique (1 = N+1, 2 = N+2…) — utile
  // quand on instancie un workflow depuis une WorkflowRule où chaque step
  // déclare son niveau. `parallelGroupId` regroupe N step-instances qui
  // doivent être traitées en parallèle (même niveau hiérarchique). `deadlineAt`
  // est calculé à partir du champ `deadlineHours` de la règle.
  level           Int?      @default(1)
  parallelGroupId String?
  deadlineAt      DateTime?

  instance   ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step       WorkflowStep     @relation(fields: [stepId], references: [id])
  decidedBy  User?            @relation("StepDecider", fields: [decidedById], references: [id])
  assignedTo User?            @relation("StepAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([instanceId])
  @@index([stepId])
  @@index([decision, dueAt])
  @@index([assignedToId])
  @@index([level])
  @@index([parallelGroupId])
  @@index([deadlineAt])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

// === END NEW MODELS 2026-04-13 ===

// ============================================================
// WorkflowRule — Approbation N+1 dynamique (ISO 27001 A.5.1)
// Ajouté le 2026-04-26
// ------------------------------------------------------------
// Une règle décrit comment instancier un workflow d'approbation
// en fonction de critères évalués à la création d'un document
// (catégorie, classification, département…). Le matching se fait
// par ordre croissant de `priority` ; la première règle dont la
// condition matche est retenue.
//
// `condition` (JSONB) : map clé→valeur, ex.
//   {
//     "classification": ["CONFIDENTIEL","SECRET"],  // OR sur la valeur
//     "category":       "POLICY",                   // égalité stricte
//     "departmentId":   ["dept-1","dept-2"],
//     "minAmount":      10000                        // seuil numérique
//   }
//
// `steps` (JSONB) : tableau ordonné de paliers. Chaque palier =
//   {
//     "level":          1,
//     "approverRole":   "ADMIN",      // ou approverUserId / approverDeptId
//     "deadlineHours":  72,
//     "parallel":       false,        // true ⇒ même level, paralléliser
//     "parallelGroupId":"grp-rssi",   // optionnel
//     "name":           "Validation RSSI"
//   }
//
// Les mutations CRUD sont auditées dans WorkflowRuleAuditLog.
// ============================================================

model WorkflowRule {
  id          String   @id @default(uuid())
  name        String
  priority    Int      @default(100)
  condition   Json
  steps       Json
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([priority, isActive])
}

model WorkflowRuleAuditLog {
  id        String   @id @default(uuid())
  ruleId    String?
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([ruleId, createdAt])
}

// ============================================================
// Délégation d'approbation (ISO 27001 A.5.1, item #27)
// Ajouté le 2026-04-26
// ------------------------------------------------------------
// Un utilisateur peut déléguer ses approbations à un collègue
// sur une période (vacances, congés, mission). Le scope peut
// être :
//   - GLOBAL  : toutes les approbations de `fromUserId`
//   - SCOPED  : limité à un ou plusieurs document categories
//
// `auto` = true ⇒ délégation créée par le cron (item #27 :
// auto-déléguation au manager après N heures sans réponse).
// ============================================================

model ApprovalDelegation {
  id          String                  @id @default(uuid())
  fromUserId  String
  toUserId    String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  scope       ApprovalDelegationScope @default(GLOBAL)
  // categoriesScope est un tableau d'enum DocumentCategory (texte) — utilisé
  // si scope=SCOPED. Vide ou null = pas de filtrage (équivalent GLOBAL).
  categories  DocumentCategory[]      @default([])
  auto        Boolean                 @default(false)
  isActive    Boolean                 @default(true)
  // Si la délégation est révoquée manuellement (DELETE) on conserve la ligne
  // pour audit en mettant revokedAt.
  revokedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  fromUser User @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, isActive, startDate, endDate])
  @@index([toUserId, isActive])
  @@index([endDate])
}

enum ApprovalDelegationScope {
  GLOBAL
  SCOPED
}

/// Trace immuable de chaque action sur les approbations & délégations
/// (création / révocation / auto-délégation / escalade). Permet de
/// reconstituer la chaîne d'actions sur une approbation, en complément
/// des audit logs métiers (AuditLog).
model ApprovalAuditLog {
  id              String   @id @default(uuid())
  actorId         String?
  action          String
  // Identifiants de la ressource concernée — au moins UN doit être renseigné.
  delegationId    String?
  approvalInstanceId String?
  stepInstanceId  String?
  metadata        Json?
  createdAt       DateTime @default(now())

  actor User? @relation("ApprovalAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([delegationId])
  @@index([approvalInstanceId])
  @@index([stepInstanceId])
}

// ============================================================
// DocuSeal : campagnes automatisees (ISO 27001 A.5.1 + A.6.2)

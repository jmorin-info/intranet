// =========================================================================
// Certifications de formation
// =========================================================================

model Certificate {
  id            String    @id @default(uuid())
  name          String // Nom de la formation
  certType      String // Type de certification (ISO 27001 LA, CISSP, CEH, etc.)
  obtainedAt    DateTime // Date d'obtention
  expiresAt     DateTime? // Date d'expiration (optionnelle)
  fileUrl       String? // Pièce jointe (PDF, image)
  fileName      String?
  fileSizeBytes Int?
  // Aperçu (thumbnail 256x256) généré à l'upload — affiché dans la liste admin.
  // null si fichier sans preview possible (pas d'image, pdftoppm absent, etc.).
  thumbnailUrl  String?
  notes         String?

  // Utilisateur interne (nullable si externe)
  userId String?
  user   User?   @relation("UserCertificates", fields: [userId], references: [id])

  // Personne externe (nullable si interne)
  externalPersonId String?
  externalPerson   ExternalPerson? @relation(fields: [externalPersonId], references: [id])

  // Métadonnées
  createdById String
  createdBy   User     @relation("CertificateCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([externalPersonId])
  @@index([expiresAt])
  @@index([certType])
}

model ExternalPerson {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  company   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificates Certificate[]

  @@index([email])
  @@index([company])
}

// =============================================================================
// Testimonials (portail /welcome) — collecte avec modération ADMIN
// =============================================================================
// Collecte de témoignages authentiques sur l'intranet, affichés sur le portail
// public /welcome après modération ADMIN. Remplace les citations hardcodées
// fake qui étaient peu crédibles. Les users sont invités à soumettre de
// manière rare (toast 1/N après action positive), jamais de prompt forcé.

model Testimonial {
  id              String    @id @default(uuid())
  // Citation courte (max 280 car. pour format « tweet » compact)
  quote           String    @db.VarChar(280)
  // Snapshot du département / rôle à la soumission — permet affichage anonyme
  // tout en donnant un contexte au lecteur (« — Département IT »)
  department      String?
  role            String?
  // Utilisateur qui a soumis — nullable si user supprimé (on garde la citation)
  submittedById   String?
  submittedBy     User?     @relation("TestimonialSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  // Modération
  isApproved      Boolean   @default(false)
  submittedAt     DateTime  @default(now())
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?     @relation("TestimonialApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectionReason String?

  @@index([isApproved, approvedAt])
  @@index([submittedById])
  @@index([submittedAt])
}

// =============================================================================
// Médiathèque — galerie photos/vidéos gérée par l'équipe Marketing
// =============================================================================
// Accessible à tous les collaborateurs authentifiés (consult + download).
// Upload / gestion réservés aux users avec canManageMedia = true (ou ADMIN).
// Pas de carousel PUBLIC sur /welcome — consultation nécessite auth.

enum MediaVisibility {
  INTERNAL // tout collaborateur authentifié
  DEPARTMENT // membres d'un département spécifique
  PRIVATE // seulement créateur + admins
}

enum MediaType {
  IMAGE
  VIDEO
}

model MediaAlbum {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  description   String?
  coverItemId   String?
  // Image de couverture dédiée (upload distinct des items de l'album).
  // Stockée sous storage/media/albums/{id}/cover/. Si présente, prime sur
  // coverItem côté affichage public.
  coverImageUrl String?
  visibility    MediaVisibility @default(INTERNAL)
  departmentId  String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items      MediaItem[] @relation("AlbumItems")
  createdBy  User        @relation("MediaAlbumCreator", fields: [createdById], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  coverItem  MediaItem?  @relation("AlbumCover", fields: [coverItemId], references: [id], onDelete: SetNull)

  @@index([visibility, createdAt])
  @@index([createdById])
  @@index([slug])
}

model MediaItem {
  id            String    @id @default(uuid())
  albumId       String
  type          MediaType
  fileUrl       String
  thumbnailUrl  String
  posterUrl     String? // vidéos : frame extraite (null tant que ffmpeg absent)
  width         Int?
  height        Int?
  durationSec   Int? // vidéos uniquement
  fileSizeBytes BigInt // BigInt pour supporter > 2 Go
  mimeType      String
  title         String?
  description   String?
  tags          String[]  @default([])
  uploadedById  String
  createdAt     DateTime  @default(now())

  album      MediaAlbum          @relation("AlbumItems", fields: [albumId], references: [id], onDelete: Cascade)
  uploadedBy User                @relation("MediaItemUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  coverOf    MediaAlbum[]        @relation("AlbumCover")
  downloads  MediaItemDownload[]

  @@index([albumId, createdAt])
  @@index([uploadedById])
}

model MediaItemDownload {
  id           String   @id @default(uuid())
  itemId       String
  userId       String
  downloadedAt DateTime @default(now())

  item MediaItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User      @relation("MediaDownloader", fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([userId, downloadedAt])
}

// =============================================================================
// Cyber Score Snapshot (ISO 27001:2022 — /admin/cyber-score)
// =============================================================================
model CyberScoreSnapshot {
  id        String   @id @default(uuid())
  score     Int // 0..100 — moyenne arithmétique des 10 sous-scores
  domains   Json // Tableau [{key, iso, name, score, signals:[{label,value,weight}]}, ...]
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PCA / Plan de continuité d'activité — ISO 27001:2022 A.5.30 (ICT readiness
// for business continuity) + A.8.13/A.8.14 (backups / redundancy).
// ─────────────────────────────────────────────────────────────────────────────
model PcaRun {
  id          String    @id @default(cuid())
  scenarioId  String
  status      String // PENDING | RUNNING | SUCCESS | FAILED | CANCELLED
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int?
  result      Json?
  logs        String?   @db.Text
  triggeredBy String

  triggeredByUser User @relation("PcaRunTrigger", fields: [triggeredBy], references: [id], onDelete: Restrict)

  @@index([scenarioId, startedAt])
  @@index([status])
  @@index([triggeredBy])
}

// === Permissions GED granulaires (Phase 1 — MVP) === 2026-04-26
// ISO 27001 A.5.15 (Access Control) + A.5.18 (Privileged access management)
//
// `DocumentPermission` accorde un niveau d'accès cumulatif (READ → COMMENT →
// EDIT → ADMIN) à UNE cible parmi {user, department, role}. La contrainte XOR
// est appliquée par check constraint Postgres (voir migration SQL associée)
// + côté code (Zod) en garde-fou.
//
// Précédence (résolveur ACL côté service) :
//   1. owner du document → ADMIN automatique
//   2. permission explicite par user
//   3. permission explicite par department (via UserDepartment memberships)
//   4. permission explicite par role
//   5. fallback classification + isPublic (compat existante, pas de breaking)
model DocumentPermission {
  id           String    @id @default(uuid())
  documentId   String
  // XOR : exactement une des 3 cibles est non-null
  userId       String?
  departmentId String?
  role         String? // 'EMPLOYEE' | 'MANAGER' | 'ADMIN' | rôles UserRole
  level        String // 'READ' | 'COMMENT' | 'EDIT' | 'ADMIN' (cumulatif)
  expiresAt    DateTime?
  grantedById  String
  createdAt    DateTime  @default(now())

  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User?       @relation("DocPermUser", fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  grantedBy  User        @relation("DocPermGrantedBy", fields: [grantedById], references: [id])

  @@index([documentId])
  @@index([userId])
  @@index([departmentId])
  @@index([expiresAt])
  @@index([documentId, level])
}

// `DocumentShare` : lien de partage public token-based avec expiration et
// protection optionnelle par mot de passe (bcrypt 12 rounds). Permet la
// diffusion contrôlée à des tiers sans création de compte. ISO 27001 A.5.14
// (Information transfer) + A.5.10 (Information security in supplier rels).
//
// `requiresAuth=true` impose que le destinataire soit authentifié sur
// l'intranet pour accéder au lien (cas : partage interne avec traçabilité
// nominative). `requiresAuth=false` = lien anonyme (mot de passe + MFA fresh
// requis lors de la création).
model DocumentShare {
  id             String    @id @default(uuid())
  documentId     String
  token          String    @unique // crypto.randomBytes(32).toString('base64url')
  passwordHash   String? // bcrypt 12 rounds, null = pas de mot de passe
  expiresAt      DateTime?
  maxDownloads   Int? // null = illimité
  downloadCount  Int       @default(0)
  requiresAuth   Boolean   @default(false)
  createdById    String
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  failedAttempts Int       @default(0) // 5 mauvais mdp consécutifs → invalide
  createdAt      DateTime  @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation("DocShareCreatedBy", fields: [createdById], references: [id])

  @@index([documentId])
  @@index([token])
  @@index([expiresAt])
  @@index([createdById])
}

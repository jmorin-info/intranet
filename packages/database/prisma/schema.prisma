// =============================================================================
// OMNITECH Security Intranet — Prisma Schema
// ISO 27001:2022 Compliant Document Management System
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DIRECTION
  MANAGER
  REVIEWER
  COLLABORATEUR
  AUDITEUR
  PRESTATAIRE
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  REVIEW_APPROVED // Reviewer a validé : attente de confirmation du rédacteur avant envoi en approbation
  PENDING_APPROVAL
  APPROVED
  OBSOLETE
  ARCHIVED
}

enum DocumentCategory {
  POLICY
  PROCEDURE
  PLAN
  RECORD
  FORM
  GUIDE
  REPORT
  CONTRACT
  OTHER
}

enum NotificationType {
  DOC_PUBLISHED
  DOC_REVIEW_NEEDED
  DOC_APPROVAL_NEEDED
  DOC_APPROVED
  DOC_REJECTED
  SIGNATURE_NEEDED
  REVIEW_OVERDUE
  ACK_REQUIRED
  NEWS_POSTED
  EXTERNAL_ACCESS_REVIEW
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_SLA_BREACH
  MENTION
  SIGNATURE_REQUEST
  SIGNATURE_REMINDER
}

// Fréquence du digest email de notifications non-lues (Vague A v1.1).
//   - NONE   : l'utilisateur a explicitement opt-out du digest
//   - DAILY  : récap quotidien à 8h locale (jours ouvrés et week-end)
//   - WEEKLY : récap hebdomadaire le lundi à 8h
// La colonne `User.digestFrequency` (typée) est la source canonique. La
// valeur reste reflétée dans `notificationPreferences.email.digest` pour
// rétrocompat de l'API JSON existante (controller Put preferences).
enum DigestFrequency {
  NONE
  DAILY
  WEEKLY
}

enum AuditSeverity {
  INFO
  WARN
  CRITICAL
}

enum ValidationStepType {
  REVIEW
  APPROVAL
}

enum ValidationAction {
  APPROVED
  REJECTED
  DELEGATED
}

enum SignatureStatus {
  PENDING
  SIGNED
  REJECTED
  EXPIRED
}

enum AccessReviewStatus {
  PENDING // En attente de revue
  APPROVED // Accès maintenu
  REVOKED // Accès à révoquer
  MODIFIED // Rôle/dept à changer
  EXPIRED // Délai dépassé sans action
}

enum AccessReviewCampaignType {
  ACCESS_RIGHTS // Revue des droits d'accès utilisateurs (par défaut)
  PASSWORDS // Revue des mots de passe (rotation / MFA absent)
  INACTIVE_USERS // Revue des comptes inactifs (>= 90 jours sans connexion)
}

enum AccessReviewCampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// =============================================================================
// Incidents & Remediations (ISO 27001 A.5.24 / A.5.25 / A.5.26 / A.5.27)
// =============================================================================

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  DETECTED
  UNDER_INVESTIGATION
  CONTAINED
  ERADICATED
  RECOVERED
  CLOSED
}

enum IncidentCategory {
  MALWARE
  PHISHING
  DATA_BREACH
  UNAUTHORIZED_ACCESS
  DENIAL_OF_SERVICE
  PHYSICAL_SECURITY
  CONFIGURATION_ERROR
  LOST_STOLEN_DEVICE
  USER_ERROR
  THIRD_PARTY
  OTHER
}

// =============================================================================
// Models
// =============================================================================

model User {
  id                          String    @id @default(uuid())
  email                       String    @unique
  passwordHash                String
  firstName                   String
  lastName                    String
  role                        UserRole
  departmentId                String?
  isActive                    Boolean   @default(true)
  lastLoginAt                 DateTime?
  deletedAt                   DateTime?
  gdprConsentAt               DateTime?
  gdprConsentIp               String?
  avatarUrl                   String?
  // MFA
  mfaEnabled                  Boolean   @default(false)
  mfaRequired                 Boolean   @default(false) // Politique MFA imposée par un admin : bloque la connexion tant que MFA n'est pas activé
  mfaSecret                   String?
  backupCodes                 String? // JSON array of hashed backup codes
  // Traçabilité de l'application de la politique MFA per-user (qui a forcé,
  // quand) — utilisé par le RSSI pour audits ISO 27001 A.5.36 (conformité). Le
  // champ mfaEnforcedById est volontairement un String non-FK pour rester
  // résilient à la suppression de l'admin actor (audit conservé).
  mfaEnforcedAt               DateTime?
  mfaEnforcedById             String?
  // Chartes
  chartesAcceptedAt           DateTime?
  // Notification preferences (per-channel × per-category) — nullable = defaults (all in-app/email ON, push only mentions+incidents)
  // Shape: { email: { tickets, documents, incidents, mentions: bool, digest: 'off'|'daily'|'weekly' }, inApp: {...}, push: {...} }
  notificationPreferences     Json?
  // Vague A v1.1 — fréquence canonique du digest email (NONE/DAILY/WEEKLY).
  // Source de vérité typée. `notificationPreferences.email.digest` est conservé
  // pour rétrocompat applicative et synchronisé par DigestService.
  digestFrequency             DigestFrequency @default(DAILY)
  // UI language preference (persisted so it follows the user across devices). Fallback: 'fr'.
  locale                      String?   @default("fr")
  // Tracks the most recent password change (admin reset, self-change, token reset).
  // Used by AccessReviewsService (PASSWORDS campaigns) to detect stale credentials.
  // Nullable: backfilled to createdAt for existing rows via the 20260424 migration.
  passwordChangedAt           DateTime?
  // First-login guided tour : timestamp of completion. Null = tour not done
  // (triggers the welcome modal on next /dashboard mount if account age < 7d).
  // Reset to null via POST /users/me/onboarding-reset when user asks to
  // re-watch the tour from Profile > Preferences.
  onboardingCompletedAt       DateTime?
  // Welcome checklist ("Démarrage rapide") on dashboard : explicit dismissal.
  // Also auto-hidden when all 5 items are completed or after 14 days.
  welcomeChecklistDismissedAt DateTime?
  // Mode humour "Noa" — opt-in par utilisateur. Réécriture sarcastique de
  // certains messages d'UI (zod, loaders, toasts succès) UNIQUEMENT si
  // le feature flag global feature.humor.noa est ON et que l'utilisateur a
  // explicitement coché cette case (admin OU profile). Exclusions dures
  // côté frontend : routes /auth/*, /mfa/*, security, audit-logs, etc.
  noaEnabled                  Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  // Relations
  department                 Department?                 @relation(fields: [departmentId], references: [id])
  charteSignatures           CharteSignature[]
  onboardingSteps            OnboardingStep[]            @relation("OnboardingUser")
  securityAlerts             SecurityAlert[]             @relation("AlertAuthor")
  securityAlertReads         SecurityAlertRead[]
  refreshTokens              RefreshToken[]
  ownedDocuments             Document[]                  @relation("DocumentOwner")
  reviewedDocuments          Document[]                  @relation("DocumentReviewer")
  approvedDocuments          Document[]                  @relation("DocumentApprover")
  uploadedVersions           DocumentVersion[]           @relation("VersionUploader")
  acknowledgments            DocumentAcknowledgment[]
  validationRequests         ValidationRequest[]         @relation("ValidationRequester")
  validationSteps            ValidationStep[]            @relation("ValidationAssignee")
  signatureRequestsMade      SignatureRequest[]          @relation("SignatureRequester")
  signatureRequestsSigned    SignatureRequest[]          @relation("SignatureSigner")
  newsPosts                  NewsPost[]                  @relation("NewsAuthor")
  newsPostViews              NewsPostView[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  dataExportRequests         DataExportRequest[]
  appConfigUpdates           AppConfig[]                 @relation("ConfigUpdater")
  // Ticketing
  ticketsCreated             Ticket[]                    @relation("TicketCreator")
  ticketsAssigned            Ticket[]                    @relation("TicketAssignee")
  ticketComments             TicketComment[]
  // Veille
  veilleAcks                 VeilleAck[]
  // Satisfaction
  satisfactionResponses      SatisfactionResponse[]
  // External access (prestataires)
  externalAccess             ExternalAccess[]
  // Profile enrichment
  phone                      String?
  jobTitle                   String?
  location                   String?
  managerId                  String?
  skills                     String? // JSON array
  languages                  String? // JSON array
  teamsLink                  String?
  // Multi-department membership
  departmentMemberships      UserDepartment[]
  // Wiki
  wikiPages                  WikiPage[]                  @relation("WikiAuthor")
  // Web Push subscriptions
  pushSubscriptions          PushSubscription[]
  // IT / Compliance exports (ISO 27001 evidence)
  itExports                  ItExport[]                  @relation("ItExportUploader")
  // Incidents & Remediations (ISO 27001 A.5.24)
  incidentsReported          Incident[]                  @relation("IncidentReporter")
  incidentsAssigned          Incident[]                  @relation("IncidentAssignee")
  remediationsAssigned       Remediation[]               @relation("RemediationResponsible")
  incidentTimeline           IncidentTimelineEntry[]     @relation("IncidentTimelineAuthor")
  // Calendar events
  calendarEvents             CalendarEvent[]             @relation("CalendarEventCreator")
  // P1.10 — événements du calendrier individuel (assigné aux tickets, etc.)
  calendarUserEvents         CalendarEvent[]             @relation("CalendarEventUser")
  // P1.10 — tokens d'abonnement iCal (révocables)
  calendarSubscriptionTokens CalendarSubscriptionToken[] @relation("CalendarSubscriptionUser")
  // Wave B — sync bidir Google / Outlook (item 33)
  calendarConnections        CalendarConnection[]        @relation("CalendarConnectionUser")
  // Wave B — tokens WebDAV pour sync Obsidian (item 16)
  webdavTokens               WebDAVToken[]               @relation("WebDAVTokenUser")
  // Manager relation
  manager                    User?                       @relation("UserManager", fields: [managerId], references: [id])
  subordinates               User[]                      @relation("UserManager")
  // Saved filters
  savedFilters               SavedFilter[]               @relation("UserSavedFilters")
  // === NEW MODELS 2026-04-13 === Approval workflows configurables (ISO 27001 A.5.1)
  workflowsCreated           ApprovalWorkflow[]          @relation("WorkflowCreator")
  workflowStepsApprover      WorkflowStep[]              @relation("StepApprover")
  workflowStepsEscalate      WorkflowStep[]              @relation("StepEscalate")
  approvalInstancesStarted   ApprovalInstance[]          @relation("InstanceStarter")
  approvalStepDecisions      ApprovalStepInstance[]      @relation("StepDecider")
  approvalStepAssignments    ApprovalStepInstance[]      @relation("StepAssignee")
  // === Signature campaigns (ISO 27001 A.5.1 + A.6.2) === 2026-04-13
  signatureCampaignsCreated  SignatureCampaign[]         @relation("CampaignCreator")
  campaignSignatures         CampaignSignature[]         @relation("SignatureRecipient")
  // === RAG / AI Search === 2026-04-14
  ragQueries                 RagQueryLog[]               @relation("RagQueryAuthor")
  // === Chat Unified (Mission 3 Phase 1) === 2026-04-20
  chatSessions               ChatSession[]               @relation("ChatSessionAuthor")
  chatFeedback               ChatMessageFeedback[]       @relation("ChatFeedbackAuthor")
  // === Chatbot share links === 2026-04-24 (polish 10 features)
  chatbotShares              ChatbotShareLink[]          @relation("ChatbotShareOwner")
  // === LDAP Pending Users === 2026-04-14
  ldapPendingProcessed       LdapPendingUser[]           @relation("LdapPendingProcessor")
  // === Certifications de formation === 2026-04-16
  certificates               Certificate[]               @relation("UserCertificates")
  certificatesCreated        Certificate[]               @relation("CertificateCreator")
  // === Testimonials === 2026-04-21
  testimonialsSubmitted      Testimonial[]               @relation("TestimonialSubmitter")
  testimonialsApproved       Testimonial[]               @relation("TestimonialApprover")
  // === Médiathèque === 2026-04-21
  canManageMedia             Boolean                     @default(false)
  mediaAlbumsCreated         MediaAlbum[]                @relation("MediaAlbumCreator")
  mediaItemsUploaded         MediaItem[]                 @relation("MediaItemUploader")
  mediaDownloads             MediaItemDownload[]         @relation("MediaDownloader")
  // === PCA / Continuité d'activité === 2026-04-24 (ISO 27001 A.5.30)
  pcaRunsTriggered           PcaRun[]                    @relation("PcaRunTrigger")
  // === Permissions GED granulaires === 2026-04-26 (ISO 27001 A.5.15)
  documentPermissions        DocumentPermission[]        @relation("DocPermUser")
  documentPermissionsGranted DocumentPermission[]        @relation("DocPermGrantedBy")
  documentSharesCreated      DocumentShare[]             @relation("DocShareCreatedBy")
  // === Délégations d'approbation === 2026-04-26 (ISO 27001 A.5.1)
  delegationsGiven           ApprovalDelegation[]        @relation("DelegationFrom")
  delegationsReceived        ApprovalDelegation[]        @relation("DelegationTo")
  approvalAuditEntries       ApprovalAuditLog[]          @relation("ApprovalAuditActor")

  @@index([departmentId])
  @@index([role])
  @@index([email, deletedAt])
  @@index([managerId])
  @@index([digestFrequency])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  // Plateforme cliente détectée à la souscription : 'ios' (Safari iOS),
  // 'macos' (Safari macOS), 'android', 'desktop' (Chrome/Firefox/Edge desktop)
  // ou 'unknown'. Utilisée pour la traçabilité et le diagnostic des échecs
  // d'envoi par plateforme. Voir docs/architecture/SAFARI_PUSH_NOTIFICATIONS.md.
  platform  String?
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String
  expiresAt      DateTime
  revokedAt      DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  // Timestamp du dernier challenge MFA validé sur cette session (login TOTP
  // in-line ou /mfa/revalidate). Persisté ici pour survivre à la rotation des
  // refresh tokens — sinon `FreshMfaGuard` exigerait une re-validation à chaque
  // refresh d'access token (15 min). Null = MFA jamais validé sur cette session.
  mfaValidatedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users             User[]
  userMemberships   UserDepartment[]
  tickets           Ticket[]         @relation("TicketDepartment")
  calendarEvents    CalendarEvent[]  @relation("CalendarEventDept")
  // === NEW MODELS 2026-04-13 === Approval workflows
  workflowStepsDept WorkflowStep[]   @relation("StepDept")
  // === Médiathèque === 2026-04-21
  mediaAlbums       MediaAlbum[]
  // === Permissions GED granulaires === 2026-04-26
  documentPermissions DocumentPermission[]
}

model UserDepartment {
  id           String   @id @default(uuid())
  userId       String
  departmentId String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
}

model Document {
  id               String           @id @default(uuid())
  title            String
  reference        String
  description      String?
  category         DocumentCategory
  status           DocumentStatus   @default(DRAFT)
  ownerId          String
  reviewerId       String?
  approverId       String?
  currentVersionId String?
  nextReviewDate   DateTime?
  isPublic         Boolean          @default(false)
  classification   String           @default("INTERNE") // PUBLIC | INTERNE | CONFIDENTIEL | SECRET (A.5.12)
  scanStatus       String           @default("PENDING") // PENDING | CLEAN | INFECTED | ERROR
  content          String? // HTML content (inline editor) — null when document is uploaded
  isNative         Boolean          @default(false) // true = born-in-intranet, false = uploaded
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  owner              User                     @relation("DocumentOwner", fields: [ownerId], references: [id])
  reviewer           User?                    @relation("DocumentReviewer", fields: [reviewerId], references: [id])
  approver           User?                    @relation("DocumentApprover", fields: [approverId], references: [id])
  versions           DocumentVersion[]
  acknowledgments    DocumentAcknowledgment[]
  isoControls        DocumentIsoControl[]
  frameworkLinks     FrameworkDocumentLink[]
  validationRequests ValidationRequest[]
  // === Permissions GED granulaires (ISO 27001 A.5.15) === 2026-04-26
  permissions        DocumentPermission[]
  shares             DocumentShare[]

  @@index([reference, deletedAt])
  @@index([status, nextReviewDate])
  @@index([category])
  @@index([ownerId])
  @@index([reviewerId])
  @@index([approverId])
  @@index([status, classification])
  @@index([deletedAt, status])
  /// idx pour documents.service.ts findAll : ACL collaborateur OR={ownerId:me} combiné au filtre status (documents.service.ts:279)
  @@index([ownerId, status])
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  versionNumber String
  fileUrl       String
  fileType      String
  fileSizeBytes Int
  checksum      String
  changeLog     String?
  uploadedById  String
  createdAt     DateTime @default(now())

  // Relations
  document           Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy         User                @relation("VersionUploader", fields: [uploadedById], references: [id])
  validationRequests ValidationRequest[]
  signatureRequests  SignatureRequest[]

  @@index([documentId])
}

model IsoControl {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  titleFr     String?
  domain      String
  description String?

  // Relations
  documents DocumentIsoControl[]
}

// Multi-framework compliance (like CISO Assistant)
model ComplianceFramework {
  id          String   @id @default(uuid())
  name        String   @unique // "ISO 27001:2022", "NIST CSF 2.0", "ANSSI BP28", "NIS2"
  version     String   @default("1.0")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  controls FrameworkControl[]
}

model FrameworkControl {
  id            String  @id @default(uuid())
  frameworkId   String
  code          String // "PR.AC-1", "BP28-R1", "Art.21(2)(a)"
  title         String
  titleFr       String?
  domain        String? // Category/function grouping
  description   String?
  descriptionFr String?
  mappedIsoCode String? // Optional mapping to ISO 27001 control code

  framework     ComplianceFramework     @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  documentLinks FrameworkDocumentLink[]

  @@unique([frameworkId, code])
  @@index([frameworkId])
}

model FrameworkDocumentLink {
  id         String   @id @default(uuid())
  controlId  String
  documentId String
  status     String   @default("LINKED") // LINKED, COVERED, PARTIAL, GAP
  createdAt  DateTime @default(now())

  control  FrameworkControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([controlId, documentId])
}

model DocumentIsoControl {
  id           String @id @default(uuid())
  documentId   String
  isoControlId String

  // Relations
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  isoControl IsoControl @relation(fields: [isoControlId], references: [id], onDelete: Cascade)

  @@unique([documentId, isoControlId])
}

model ValidationRequest {
  id                String             @id @default(uuid())
  documentId        String
  documentVersionId String
  requestedById     String
  currentStep       ValidationStepType
  status            String             @default("PENDING")
  dueDate           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  requestedBy     User             @relation("ValidationRequester", fields: [requestedById], references: [id])
  steps           ValidationStep[]

  @@index([documentVersionId])
  @@index([requestedById])
  @@index([status])
}

model ValidationStep {
  id           String             @id @default(uuid())
  requestId    String
  stepType     ValidationStepType
  assignedToId String
  action       ValidationAction?
  comment      String?
  actionAt     DateTime?
  createdAt    DateTime           @default(now())

  // Relations
  request    ValidationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignedTo User              @relation("ValidationAssignee", fields: [assignedToId], references: [id])

  @@index([requestId])
  @@index([assignedToId])
}

model SignatureRequest {
  id                   String          @id @default(uuid())
  documentVersionId    String
  docusealSubmissionId String?
  requestedById        String
  signerId             String
  status               SignatureStatus @default(PENDING)
  signedAt             DateTime?
  signedFileUrl        String?
  webhookPayload       Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Relations
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  requestedBy     User            @relation("SignatureRequester", fields: [requestedById], references: [id])
  signer          User            @relation("SignatureSigner", fields: [signerId], references: [id])

  @@index([documentVersionId])
  @@index([signerId])
  @@index([status])
}

model DocumentAcknowledgment {
  id             String   @id @default(uuid())
  documentId     String
  userId         String?
  acknowledgedAt DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  // Snapshot identité acteur (ISO 27001 A.5.28 — preuve 3 ans post-suppression)
  userEmail      String?
  userFirstName  String?
  userLastName   String?
  userRole       String?

  // Relations — onDelete SetNull sur user pour préserver la preuve
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([documentId, userId])
}

model NewsPost {
  id            String     @id @default(uuid())
  title         String
  slug          String     @unique
  content       String
  excerpt       String?
  coverImageUrl String?
  category      String?
  isPinned      Boolean    @default(false)
  isPublished   Boolean    @default(false)
  publishedAt   DateTime?
  authorId      String
  targetRoles   UserRole[]
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  author User           @relation("NewsAuthor", fields: [authorId], references: [id])
  views  NewsPostView[]

  @@index([isPublished, publishedAt])
  @@index([authorId])
  @@index([slug])
}

model NewsPostView {
  id         String   @id @default(uuid())
  newsPostId String
  userId     String
  viewedAt   DateTime @default(now())

  // Relations
  newsPost NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([newsPostId, userId])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  title        String
  body         String?
  resourceType String?
  resourceId   String?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id           String        @id @default(uuid())
  userId       String?
  ipAddress    String?
  userAgent    String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  severity     AuditSeverity @default(INFO)
  createdAt    DateTime      @default(now())
  /// RGPD : timestamp d'anonymisation des champs PII (userId, ipAddress, userAgent, metadata).
  /// NULL = ligne brute encore consultable. Non-NULL = ligne anonymisée par
  /// AuditAnonymizationService (cron quotidien 4h). Voir docs/compliance/AUDIT_LOG_RETENTION.md.
  anonymizedAt DateTime?

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([resourceType, action])
  @@index([action, createdAt])
  @@index([severity])
  /// idx pour audit.service.ts getStats : critical events sur une fenêtre de dates triés par createdAt (audit.service.ts:184)
  @@index([severity, createdAt])
  /// idx pour journal d'audit per-user filtré par action (audit.service.ts findMany combinant userId + action LIKE + orderBy createdAt)
  @@index([userId, action, createdAt])
  /// idx pour AuditAnonymizationService cron : sélectionne lignes
  /// `createdAt < cutoffFull AND anonymizedAt IS NULL`. Crée aussi le scan
  /// `anonymizedAt < cutoffPurge` pour la phase deleteMany.
  @@index([anonymizedAt, createdAt])
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model DataExportRequest {
  id           String           @id @default(uuid())
  userId       String
  requestedAt  DateTime         @default(now())
  processedAt  DateTime?
  completedAt  DateTime?
  status       DataExportStatus @default(PENDING)
  // filePath = chemin disque relatif au STORAGE_PATH (utile au processor
  // pour cleanup/relocalisation). downloadUrl reste l'URL côté API exposée
  // au client, conservée pour rétrocompat.
  filePath     String?
  downloadUrl  String?
  errorMessage String?
  expiresAt    DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  // Relations
  updatedBy User? @relation("ConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

// =============================================================================
// Ticketing — Multi-space architecture
// =============================================================================
// Generalized from "Ticketing IT" to support multiple spaces (IT, HR, Facilities,
// Security, etc.). Each space has its own categories, templates, SLA config, and
// RBAC rules. Existing tickets without a spaceId are treated as belonging to the
// default "IT" space for backward compatibility.
// =============================================================================

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketCategory {
  INCIDENT
  REQUEST
  ACCESS
  HARDWARE
  SOFTWARE
  NETWORK
  SECURITY
  OTHER
}

/// A ticketing space represents a logical domain (IT, RH, Services Generaux,
/// Securite, etc.). Each space can define its own categories, templates, SLA
/// policies, and access control rules.
model TicketSpace {
  id                String   @id @default(uuid())
  name              String   @unique // "IT", "RH", "Services Generaux", "Securite"
  slug              String   @unique // "it", "rh", "services-generaux", "securite"
  description       String?
  icon              String? // Lucide icon name for the sidebar
  color             String? // Hex color for visual distinction
  isDefault         Boolean  @default(false) // The default space for tickets created without explicit space
  isActive          Boolean  @default(true)
  /// JSON array of allowed TicketCategory values for this space.
  /// null = all categories allowed.
  allowedCategories String[] @default([])
  /// JSON config for space-specific SLA thresholds (overrides global defaults).
  /// Schema: { "CRITICAL": 4, "HIGH": 8, "MEDIUM": 24, "LOW": 48 }
  slaConfig         Json?
  /// JSON config for space-specific templates, labels, and custom fields.
  config            Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tickets Ticket[]
  members TicketSpaceMember[]

  @@index([isActive])
  @@index([slug])
}

/// RBAC membership for a ticket space. Defines who can view/create/manage
/// tickets within a given space.
model TicketSpaceMember {
  id           String                @id @default(uuid())
  spaceId      String
  /// Scope: assign access to a specific user, a role, or a department.
  /// Only one of userId/role/departmentId should be set.
  userId       String?
  role         String? // UserRole value — grants access to all users with this role
  departmentId String?
  /// Permission level within the space.
  permission   TicketSpacePermission @default(VIEWER)
  createdAt    DateTime              @default(now())

  space TicketSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@unique([spaceId, role])
  @@unique([spaceId, departmentId])
  @@index([spaceId])
  @@index([userId])
}

enum TicketSpacePermission {
  VIEWER // Can view tickets in the space
  CREATOR // Can create + view
  AGENT // Can create + view + be assigned + comment internally
  MANAGER // Full control: assign, close, configure
}

model Ticket {
  id                     String         @id @default(uuid())
  reference              String         @unique
  title                  String
  description            String
  category               TicketCategory @default(OTHER)
  priority               TicketPriority @default(MEDIUM)
  status                 TicketStatus   @default(OPEN)
  tags                   String[]       @default([])
  creatorId              String
  assigneeId             String?
  departmentId           String?
  /// The space this ticket belongs to. Nullable for backward compatibility
  /// with pre-migration tickets (treated as default/IT space).
  spaceId                String?
  resolvedAt             DateTime?
  closedAt               DateTime?
  // Dates métier (P1.10) — utilisées pour la synchro calendrier individuel
  // de l'assigné. Toutes nullables, patchables via PATCH /tickets/:id/dates.
  dueDate                DateTime?
  clientShipmentDate     DateTime?
  materialReceivedDate   DateTime?
  deployedAt             DateTime?
  deploymentScheduledFor DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  creator    User            @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee   User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  department Department?     @relation("TicketDepartment", fields: [departmentId], references: [id])
  space      TicketSpace?    @relation(fields: [spaceId], references: [id])
  comments   TicketComment[]

  @@index([creatorId])
  @@index([assigneeId])
  @@index([departmentId])
  @@index([spaceId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([creatorId, status])
  @@index([assigneeId, status])
  @@index([spaceId, status])
  @@index([spaceId, createdAt])
  /// idx pour findAll : filtre status + priority trié par createdAt (tickets.service.ts findAll)
  @@index([status, priority, createdAt])
  /// idx pour ACL non-admin : where.OR contient { departmentId } combiné au filtre status (tickets.service.ts:348,391)
  @@index([departmentId, status])
  /// idx pour P1.10 : tickets de l'assigné avec dueDate (synchro calendrier individuel + overdue queue)
  @@index([assigneeId, dueDate])
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}


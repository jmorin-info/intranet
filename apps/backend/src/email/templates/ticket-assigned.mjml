<!-- subject:fr [OMNITECH] Nouveau ticket assigné #{{ ticketId }} — {{ ticketTitle }} -->
<!-- subject:en [OMNITECH] New ticket assigned #{{ ticketId }} — {{ ticketTitle }} -->
{{> greeting }}

<mj-section padding="16px 32px 0 32px">
  <mj-column>
    <mj-text font-size="16px" color="{{ colors.navy }}" font-weight="bold" padding="0 0 4px 0">
      Nouveau ticket assign&eacute;
    </mj-text>
    <mj-text color="{{ colors.darkGray }}" padding="0 0 12px 0">
      <strong>{{ assignerName }}</strong> vient de vous assigner un nouveau ticket helpdesk.
      Merci de le prendre en charge dans les meilleurs d&eacute;lais selon le SLA en vigueur.
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="0 32px">
  <mj-column background-color="#f8f9fa" border-radius="6px" padding="0">
    <mj-table padding="16px 20px" font-size="13px">
      <tr style="border-bottom:1px solid #e5e7eb;">
        <td style="padding:6px 0;color:#6b7280;font-weight:600;width:120px;">Ticket</td>
        <td style="padding:6px 0;color:#111827;">#{{ ticketId }}</td>
      </tr>
      <tr style="border-bottom:1px solid #e5e7eb;">
        <td style="padding:6px 0;color:#6b7280;font-weight:600;">Titre</td>
        <td style="padding:6px 0;color:#111827;">{{ ticketTitle }}</td>
      </tr>
      <tr style="border-bottom:1px solid #e5e7eb;">
        <td style="padding:6px 0;color:#6b7280;font-weight:600;">Cat&eacute;gorie</td>
        <td style="padding:6px 0;color:#111827;">{{ ticketCategory }}</td>
      </tr>
      <tr>
        <td style="padding:6px 0;color:#6b7280;font-weight:600;">Priorit&eacute;</td>
        <td style="padding:6px 0;">
          <span class="seal-badge" style="background:{{ colors.orange }};">{{ ticketPriority }}</span>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>

<mj-section padding="24px 32px 32px 32px">
  <mj-column>
    <mj-button href="{{ ticketUrl }}" background-color="{{ colors.orange }}">
      Ouvrir le ticket
    </mj-button>
  </mj-column>
</mj-section>

<!-- subject:fr [OMNITECH] Votre ticket #{{ ticketId }} a été résolu -->
<!-- subject:en [OMNITECH] Your ticket #{{ ticketId }} has been resolved -->
{{> greeting }}

<mj-section padding="16px 32px 0 32px">
  <mj-column>
    <mj-text font-size="16px" color="{{ colors.navy }}" font-weight="bold" padding="0 0 4px 0">
      Ticket r&eacute;solu &#10003;
    </mj-text>
    <mj-text color="{{ colors.darkGray }}" padding="0 0 12px 0">
      Bonne nouvelle ! Votre ticket <strong>#{{ ticketId }} &mdash; {{ ticketTitle }}</strong>
      vient d'&ecirc;tre marqu&eacute; comme r&eacute;solu par <strong>{{ resolverName }}</strong>.
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="0 32px">
  <mj-column background-color="#f0fdf4" border-left="3px solid {{ colors.green }}" padding="14px 18px">
    <mj-text padding="0" color="#065f46" font-size="13px">
      <strong>R&eacute;sum&eacute; de la r&eacute;solution :</strong><br/>
      {{ resolutionSummary }}
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="24px 32px 8px 32px">
  <mj-column>
    <mj-button href="{{ ticketUrl }}" background-color="{{ colors.blue }}">
      Voir le ticket et &eacute;valuer
    </mj-button>
    <mj-text align="center" font-size="12px" color="{{ colors.mediumGray }}" padding="12px 0 0 0">
      Si la solution ne vous convient pas, vous pouvez r&eacute;ouvrir le ticket
      depuis le bouton ci-dessus.
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="0 32px 32px 32px">
  <mj-column>
    <mj-text font-size="11px" color="{{ colors.mediumGray }}" align="center" padding="8px 0 0 0">
      Votre satisfaction nous aide &agrave; am&eacute;liorer le support &mdash; merci d'&eacute;valuer la r&eacute;solution.
    </mj-text>
  </mj-column>
</mj-section>

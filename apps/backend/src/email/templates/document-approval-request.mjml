<!-- subject:fr [OMNITECH] Validation requise — {{ documentTitle }} -->
<!-- subject:en [OMNITECH] Approval required — {{ documentTitle }} -->
{{> greeting }}

<mj-section padding="16px 32px 0 32px">
  <mj-column>
    <mj-text font-size="16px" color="{{ colors.navy }}" font-weight="bold" padding="0 0 4px 0">
      Validation requise
    </mj-text>
    <mj-text color="{{ colors.darkGray }}" padding="0 0 12px 0">
      <strong>{{ requesterName }}</strong> sollicite votre validation sur un document
      avant publication. Veuillez relire le contenu, valider ou demander des
      corrections avant le <strong>{{ deadline }}</strong>.
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="0 32px">
  <mj-column background-color="#f8f9fa" border-radius="6px" padding="0">
    <mj-table padding="14px 18px" font-size="13px">
      <tr style="border-bottom:1px solid #e5e7eb;">
        <td style="padding:6px 0;color:#6b7280;font-weight:600;width:140px;">Document</td>
        <td style="padding:6px 0;color:#111827;">{{ documentTitle }}</td>
      </tr>
      <tr style="border-bottom:1px solid #e5e7eb;">
        <td style="padding:6px 0;color:#6b7280;font-weight:600;">Classification</td>
        <td style="padding:6px 0;">
          <span class="seal-badge" style="background:{{ colors.blue }};">{{ documentClassification }}</span>
        </td>
      </tr>
      <tr>
        <td style="padding:6px 0;color:#6b7280;font-weight:600;">Demandeur</td>
        <td style="padding:6px 0;color:#111827;">{{ requesterName }}</td>
      </tr>
      <tr>
        <td style="padding:6px 0;color:#6b7280;font-weight:600;">Date limite</td>
        <td style="padding:6px 0;color:#b45309;font-weight:bold;">{{ deadline }}</td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>

<mj-section padding="24px 32px 32px 32px">
  <mj-column>
    <mj-button href="{{ documentUrl }}" background-color="{{ colors.orange }}">
      Examiner et valider
    </mj-button>
    <mj-text align="center" font-size="11px" color="{{ colors.mediumGray }}" padding="14px 0 0 0">
      Sans action de votre part avant la date limite, le document sera escalad&eacute; au
      <a href="{{ appUrl }}/admin/approval-workflows" class="seal-link">workflow de secours</a>.
    </mj-text>
  </mj-column>
</mj-section>

<!-- subject:fr Votre digest {{ period }} OMNITECH ({{ totalCount }} notifications) -->
<!-- subject:en Your {{ period }} OMNITECH digest ({{ totalCount }} notifications) -->
{{> greeting }}

<mj-section padding="16px 32px 0 32px">
  <mj-column>
    <mj-text font-size="16px" color="{{ colors.navy }}" font-weight="bold" padding="0 0 4px 0">
      Votre digest {{ period }}
    </mj-text>
    <mj-text color="{{ colors.darkGray }}" font-size="14px" padding="0">
      Voici un r&eacute;sum&eacute; de <strong>{{ totalCount }}</strong> notifications re&ccedil;ues
      depuis votre derni&egrave;re connexion. Cliquez sur un &eacute;l&eacute;ment pour acc&eacute;der directement
      &agrave; la ressource concern&eacute;e.
    </mj-text>
  </mj-column>
</mj-section>

{{#each modules}}
<mj-section padding="20px 32px 0 32px">
  <mj-column>
    <mj-text padding="0 0 8px 0">
      <span class="seal-badge" style="background:{{ this.color }};">{{ this.label }}</span>
    </mj-text>
    {{#each this.items}}
    <mj-text padding="6px 0" font-size="13px" line-height="20px">
      <strong style="color:{{ colors.navy }};">
        <a href="{{ this.url }}" style="color:{{ colors.navy }};text-decoration:none;">{{ this.title }}</a>
      </strong>
      <span style="color:{{ colors.mediumGray }};font-size:11px;">&nbsp;&middot;&nbsp;{{ this.time }}</span>
      <br/>
      <span style="color:{{ colors.darkGray }};">{{ this.body }}</span>
    </mj-text>
    {{/each}}
    <mj-divider border-color="#e5e7eb" border-width="1px" padding="12px 0 0 0" />
  </mj-column>
</mj-section>
{{/each}}

<mj-section padding="24px 32px 32px 32px">
  <mj-column>
    <mj-button href="{{ appUrl }}/notifications" background-color="{{ colors.orange }}">
      Voir toutes mes notifications
    </mj-button>
    <mj-text align="center" font-size="11px" color="{{ colors.mediumGray }}" padding="16px 0 0 0">
      Vous pouvez modifier la fr&eacute;quence du digest depuis
      <a href="{{ preferencesUrl }}" class="seal-link">vos pr&eacute;f&eacute;rences</a>.
    </mj-text>
  </mj-column>
</mj-section>

<!-- subject:fr [OMNITECH] Réinitialisation de votre mot de passe -->
<!-- subject:en [OMNITECH] Password reset request -->
{{> greeting }}

<mj-section padding="16px 32px 0 32px">
  <mj-column>
    <mj-text font-size="16px" color="{{ colors.navy }}" font-weight="bold" padding="0 0 4px 0">
      R&eacute;initialisation de votre mot de passe
    </mj-text>
    <mj-text color="{{ colors.darkGray }}" padding="0 0 12px 0">
      Une demande de r&eacute;initialisation de mot de passe a &eacute;t&eacute; effectu&eacute;e pour votre
      compte OMNITECH Security. Cliquez sur le bouton ci-dessous pour d&eacute;finir
      un nouveau mot de passe.
    </mj-text>
    <mj-text color="{{ colors.darkGray }}" padding="0 0 12px 0">
      Ce lien est valable <strong>{{ expirationMinutes }} minutes</strong>. Au-del&agrave;,
      vous devrez refaire une demande.
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="8px 32px 8px 32px">
  <mj-column>
    <mj-button href="{{ resetUrl }}" background-color="{{ colors.orange }}">
      D&eacute;finir un nouveau mot de passe
    </mj-button>
  </mj-column>
</mj-section>

<mj-section padding="0 32px">
  <mj-column background-color="#f8f9fa" border-radius="6px" padding="14px 18px">
    <mj-text padding="0" font-size="12px" color="{{ colors.darkGray }}">
      <strong>D&eacute;tails de la demande :</strong><br/>
      &middot; Date / heure : {{ requestTime }}<br/>
      &middot; Adresse IP : <code>{{ requestIp }}</code>
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="14px 32px 32px 32px">
  <mj-column>
    <mj-text font-size="11px" color="{{ colors.mediumGray }}" padding="0">
      <strong>Vous n'&ecirc;tes pas &agrave; l'origine de cette demande ?</strong>
      Ignorez cet email &mdash; votre mot de passe n'a pas &eacute;t&eacute; modifi&eacute;. Si vous suspectez
      une compromission de votre compte, contactez imm&eacute;diatement le RSSI ou
      <a href="{{ appUrl }}/helpdesk/new" class="seal-link">ouvrez un ticket urgent</a>.
    </mj-text>
  </mj-column>
</mj-section>

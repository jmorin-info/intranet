# =============================================================================
# OMNITECH mobile — Capacitor wrap (root)
# =============================================================================
# What lives here :
#   - capacitor.config.ts (committed)
#   - package.json + pnpm lockfile (committed via root pnpm-lock.yaml)
#   - ios/        => Xcode project, generated by `cap add ios`. Committed for
#                    custom Info.plist / entitlements / native plugin tweaks.
#                    Has its own .gitignore for build artefacts.
#   - android/    => Android Studio project, generated by `cap add android`.
#                    Committed for AndroidManifest.xml / build.gradle tweaks.
#                    Has its own .gitignore for build artefacts.
# =============================================================================

# Local env (signing creds, FCM service account, APNs keys)
.env
.env.local
.env.*.local

# Build artefacts (typescript out, capacitor cache)
dist/
build/
out/
.capacitor/
capacitor-cache/

# Sensitive — must NEVER hit git
# iOS
*.mobileprovision
*.p8
*.p12
ios/App/App/GoogleService-Info.plist
# Android
android/app/google-services.json
android/app/*.keystore
android/app/*.jks

# Node
node_modules/
*.log
npm-debug.log*
pnpm-debug.log*

# IDE / OS
.DS_Store
Thumbs.db
*.swp

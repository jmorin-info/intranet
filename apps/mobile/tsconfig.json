{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": ["capacitor.config.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "ios", "android", "dist"]
}

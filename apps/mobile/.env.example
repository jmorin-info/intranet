# =============================================================================
# OMNITECH Intranet — Capacitor mobile build env
# =============================================================================
# Copy this file to `.env.local` (gitignored) and fill in your local values.
# Variables here are consumed by `capacitor.config.ts` at `cap sync` / build
# time — they are NOT shipped at runtime in the binary unless you add them
# to a config plugin explicitly.
# =============================================================================

# -----------------------------------------------------------------------------
# WebView entrypoint
# -----------------------------------------------------------------------------
# URL chargee par la WebView au demarrage de l'app native. Defaut : prod URL.
# - Prod         : https://intranet.omnitech-security.fr (laisse vide ou commente)
# - Staging      : https://intranet-staging.omnitech-security.fr
# - Dev local    : http://192.168.1.X:3001 (IP de la machine sur le LAN ;
#                  le port 3001 = `pnpm --filter frontend dev`)
# - Dev iOS sim  : http://localhost:3001 (le simulateur partage le loopback)
# - Dev Android  : http://10.0.2.2:3001 (alias emulator -> host loopback)
# IMPORTANT : sur device physique iOS / Android, localhost ne fonctionne pas
# car il pointe vers le device lui-meme. Utilise l'IP LAN de ta machine.
CAPACITOR_SERVER_URL=https://intranet.omnitech-security.fr

# -----------------------------------------------------------------------------
# Build mode
# -----------------------------------------------------------------------------
# `production` desactive le debug WebView Android (chrome://inspect off).
# Defaut en CI : `production`. En dev : `development`.
NODE_ENV=development

# -----------------------------------------------------------------------------
# iOS — signing (utilise par les scripts de build natif uniquement)
# -----------------------------------------------------------------------------
# Bundle ID prod : doit matcher l'App ID configure dans Apple Developer Portal.
# Pour les builds dev / TestFlight on peut utiliser un bundle id distinct
# (ex : fr.omnitechsecurity.intranet.dev) pour ne pas collisionner avec
# l'app prod sur le device.
IOS_BUNDLE_ID=fr.omnitechsecurity.intranet
IOS_TEAM_ID=                  # Apple Developer Team ID (10 chars), ex: ABCD123456
IOS_PROVISIONING_PROFILE=     # Nom du profile (ex: OMNITECH Intranet AdHoc)

# -----------------------------------------------------------------------------
# Android — signing (utilise par gradle release builds)
# -----------------------------------------------------------------------------
ANDROID_KEYSTORE_PATH=        # ex: ~/.keystores/omnitech-intranet.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=omnitech-intranet
ANDROID_KEY_PASSWORD=

# -----------------------------------------------------------------------------
# Push notifications — Firebase Cloud Messaging (Android)
# -----------------------------------------------------------------------------
# Le fichier `google-services.json` (telecharge depuis Firebase Console)
# doit etre place dans `android/app/google-services.json` apres `cap add android`.
# Ce path est relatif au worktree mobile root.
FIREBASE_GOOGLE_SERVICES_JSON_PATH=./android/app/google-services.json

# -----------------------------------------------------------------------------
# Push notifications — APNs (iOS)
# -----------------------------------------------------------------------------
# La cle .p8 APNs (telecharge depuis Apple Developer Portal -> Keys) doit etre
# uploade cote backend, pas commit ici. Cette variable documente juste le path
# attendu pour le tooling local (signing).
APNS_KEY_ID=
APNS_TEAM_ID=

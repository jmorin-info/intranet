# ============================================
# OMNITECH Intranet — Configuration Template
# Copy to .env and fill in real values
# NEVER commit .env to version control
# ============================================

# === Application ===
NODE_ENV=production
APP_NAME="OMNITECH Intranet"
APP_URL=https://intranet.omnitech-security.fr
PORT=3000
HOST=0.0.0.0

# === Database (PostgreSQL — ISO 27001 A.8.24) ===
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
POSTGRES_USER=omnitech
POSTGRES_PASSWORD=changeme
POSTGRES_DB=omnitech_intranet

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# === Auth & JWT (ISO 27001 A.8.5) — Must be 64+ characters ===
JWT_ACCESS_SECRET=changeme_minimum_64_characters_random_string_here_use_openssl_rand
JWT_REFRESH_SECRET=changeme_minimum_64_characters_random_string_here_use_openssl_rand
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === Crypto at-rest (Wave B) ===
# Clé maître AES-256-GCM utilisée par CryptoService pour chiffrer les
# secrets persistés (tokens OAuth Google/Outlook). 32 bytes minimum, 64 chars
# hex recommandés. Générer : `openssl rand -hex 32`. En PROD, OBLIGATOIRE
# (sinon fallback dérivé de JWT_ACCESS_SECRET avec warning, à n'utiliser
# qu'en dev). Toute rotation de cette clé invalide tous les tokens chiffrés
# (les users devront se reconnecter à Google/Outlook).
CRYPTO_SECRET=

# === Calendar OAuth — Google & Microsoft 365 (Wave B item 33) ===
# Sync bidirectionnel des évènements de calendrier. Cf.
# docs/integrations/CALENDAR_SYNC.md pour le setup complet (création client
# OAuth Google Cloud Console / App Registrations Azure AD, redirect URIs,
# scopes nécessaires).
#
# Google (https://console.cloud.google.com/apis/credentials) :
#   - Type "Web application"
#   - Authorized redirect URI : ${APP_URL}/api/v1/calendar/callback/google
#   - Scopes : .../auth/calendar.events, openid, email
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
# Microsoft 365 (https://portal.azure.com → Azure AD → App registrations) :
#   - Redirect URI (Web) : ${APP_URL}/api/v1/calendar/callback/outlook
#   - API permissions delegated : Calendars.ReadWrite, offline_access, User.Read
#   - Activer "ID tokens" (Implicit grant) NON requis (on utilise auth-code).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Désactive les pulls cron (utile en dev pour ne pas spammer les API tierces)
CALENDAR_SYNC_CRON_ENABLED=true

# === Rate limiting (ThrottlerModule) ===
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
# Storage backend pour les compteurs de rate limit (item 15, Vague A v1.1).
# Si vide ou invalide, fallback automatique sur le Redis générique
# (REDIS_HOST/PORT/PASSWORD ci-dessus). Format URL ioredis :
#   redis://[:password@]host:port[/db]
# Ex en prod : redis://:PASSWORD@redis-throttle.internal:6379/2
THROTTLER_REDIS_URL=
# Si "true" : refuser les requêtes (HTTP 429) quand Redis est down au lieu
# de tomber sur le compteur in-memory local. À activer en prod sensible où
# l'incohérence inter-instance n'est pas tolérable.
THROTTLER_REDIS_REQUIRED=false

# === HaveIBeenPwned password check (ANSSI R20) ===
# Vérification k-anonymity des mots de passe contre la base HIBP.
# Le mot de passe ne quitte JAMAIS le serveur (seuls les 5 premiers chars du SHA-1).
# Graceful degradation : si l'API HIBP est down, on log mais on accepte.
HIBP_ENABLED=true
HIBP_THRESHOLD=100

# === LDAP / Active Directory ===
# NOTE: LDAP connection settings are stored in the database (table ldap_config)
# and managed via the admin UI. No LDAP_* env vars are required.

# === SMTP (email notifications) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme
SMTP_FROM="OMNITECH Intranet <noreply@example.com>"

# === Storage (local filesystem) ===
STORAGE_PATH=/opt/omnitech/storage
STORAGE_SECRET=changeme_random_string_for_signed_urls
UPLOAD_MAX_SIZE_MB=50

# === CMS — revalidation Next.js ===
# Secret partagé entre le backend (qui POSTe à `/api/cms/revalidate` après
# publication d'un bloc / d'une page) et le frontend Next.js qui vérifie le
# header `X-CMS-Revalidate-Secret`. Doit faire >= 16 caractères, générer via
# `openssl rand -hex 32`. Sans valeur configurée, l'endpoint répond 500
# (fail-closed).
CMS_REVALIDATE_SECRET=changeme_minimum_16_characters_use_openssl_rand_hex_32

# === External APIs — DocuSeal (electronic signatures) ===
DOCUSEAL_URL=https://docuseal.example.com
DOCUSEAL_API_URL=http://localhost:7000/api
DOCUSEAL_API_KEY=changeme
# Secret HMAC-SHA256 partagé avec DocuSeal (admin → Webhooks → Secret).
# Le backend vérifie le header X-DocuSeal-Signature = HMAC_SHA256(body, secret).
# ISO 27001 A.8.26 — Application security requirements.
DOCUSEAL_WEBHOOK_SECRET=changeme
# Mode HMAC (par défaut true). Mettre à false UNIQUEMENT en rollback d'urgence
# pour retomber sur l'ancienne comparaison en clair (DEPRECATED).
DOCUSEAL_WEBHOOK_SECRET_HMAC_MODE=true
DOCUSEAL_TEMPLATE_ID=1
# Point d'entrée webhook UNIQUE côté DocuSeal : POST /api/v1/signatures/webhook
# (l'ancien /signature-campaigns/webhook/docuseal répond 410 Gone).
#
# Signature "au clic" sans DocuSeal ni preuve eIDAS (PATCH /signatures/:id/sign) :
# DÉSACTIVÉE par défaut. Une signature engageante passe TOUJOURS par DocuSeal.
# Ne passer à true qu'en rollback d'urgence — les signatures produites dans ce
# mode n'ont AUCUNE valeur probante (pas de SignatureEvidence).
SIGNATURES_ALLOW_DIRECT=false

# === External APIs — Corporate file server (SMB/CIFS) ===
FILESERVER_HOST=10.33.50.5
FILESERVER_USER=svc_intranet@example.local
FILESERVER_SERVICE_PASSWORD=changeme
# Legacy alias, kept for backward compatibility
FILESERVER_PASSWORD=changeme

# === Web Push (VAPID) — ISO 27001 A.5.13 ===
# Generate keys with: ./scripts/generate-vapid.sh
# (or: pnpm --filter @omnitech/backend exec npx web-push generate-vapid-keys --json)
# WARNING: never commit real keys. The values below are placeholders.
VAPID_PUBLIC_KEY=BNa_PLACEHOLDER_PUBLIC_KEY_REPLACE_WITH_REAL_VALUE
VAPID_PRIVATE_KEY=PLACEHOLDER_PRIVATE_KEY_REPLACE_WITH_REAL_VALUE
VAPID_SUBJECT=mailto:noc@omnitech-security.fr

# === CORS ===
CORS_ORIGINS=https://intranet.omnitech-security.fr

# === Reverse proxy (BunkerWeb) ===
# IP du réseau ou CIDR auquel faire confiance pour X-Forwarded-For.
# 'loopback, linklocal, uniquelocal' couvre les réseaux privés RFC1918.
# Pour restreindre à BunkerWeb uniquement : mettre son CIDR, ex "10.33.0.0/16".
TRUST_PROXY=loopback, linklocal, uniquelocal

# IP LAN sur laquelle publier les ports Docker (backend/frontend/onlyoffice).
# Seule cette interface sera accessible — le pare-feu doit limiter à BunkerWeb.
# Laisser 127.0.0.1 si BunkerWeb tourne sur le même hôte.
DOCKER_BIND_IP=10.33.120.55

# === Frontend (Next.js — NEXT_PUBLIC_* are exposed to the browser) ===
NEXT_PUBLIC_API_URL=https://intranet.omnitech-security.fr/api
NEXT_PUBLIC_APP_NAME="OMNITECH Intranet"
NEXT_PUBLIC_WS_URL=wss://intranet.omnitech-security.fr
NEXT_PUBLIC_DOCUSEAL_URL=https://docuseal.example.com

# === CDN — Item 32 (Bunny.net recommandé / Cloudflare alternative) ===
# Origin URL du CDN qui sert les assets statiques (Next.js _next/static/*,
# fonts, images, JS chunks). Laisser VIDE en dev et en preprod sans CDN —
# Next.js servira les assets directement depuis le frontend (rétrocompatible).
# En prod : `https://cdn.intranet.omnitech-security.fr` (CNAME vers Bunny
# Pull Zone). Cf. docs/infrastructure/CDN_SETUP.md pour le setup.
NEXT_PUBLIC_CDN_URL=
# Provider CDN : `bunny` (recommandé, EU) ou `cloudflare` (global, US peering
# possible). Utilisé par scripts/deploy-cdn-assets.sh pour choisir l'API.
CDN_PROVIDER=bunny
# Storage Zone (Bunny) — nom + clé (write key) pour upload des assets.
# Ces valeurs sont des SECRETS : utiliser un secret manager ou un Docker
# secret en prod. Ne JAMAIS commit la clé.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Bunny endpoint (Slovénie par défaut, alternatives : storage.bunnycdn.com
# pour Falkenstein/DE, sg.storage.bunnycdn.com pour Singapour…).
BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com
# Pull Zone ID + API key pour purger le cache après déploiement.
# Token : https://dash.bunny.net/account/api-keys (compte → API → Account API Key)
BUNNY_PULL_ZONE_ID=
CDN_PURGE_TOKEN=
# Cloudflare alternative — si CDN_PROVIDER=cloudflare :
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_R2_BUCKET=intranet-assets
# CLOUDFLARE_R2_ACCESS_KEY_ID=...
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=...
# CLOUDFLARE_ZONE_ID=... (pour purge)

# === Logging ===
# Pino structured logger level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# === Observabilité — Sentry (opt-in) ===
# Laisser VIDE pour désactiver toute télémétrie externe (mode on-prem / air-gapped).
# Pour activer : créer un projet Sentry (cloud ou self-hosted) et coller le DSN.
# Le backend envoie UNIQUEMENT les 5xx et exceptions non gérées (jamais les 4xx).
# Les bodies, cookies, et headers Authorization/x-api-key sont strippés avant envoi.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# SHA du commit en cours de déploiement, optionnel mais recommandé pour grouper.
SENTRY_RELEASE=

# DSN du projet Sentry "frontend" (Next.js). NEXT_PUBLIC_ requis pour exposer au browser bundle.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_RELEASE=
# Optionnel — taux de session replay (0 = désactivé). Augmenter avec parcimonie (RGPD).
NEXT_PUBLIC_SENTRY_REPLAY_RATE=0

# Source maps upload (CI uniquement — ne PAS committer SENTRY_AUTH_TOKEN)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# === SIEM — Graylog (opt-in, best-effort) ===
# Désactivé par défaut. Aucun impact si Graylog est injoignable (fire-and-forget UDP).
SIEM_ENABLED=false
SIEM_GELF_HOST=10.33.220.10
SIEM_GELF_PORT=12201
SIEM_APP_NAME=omnitech-intranet-backend
# Ne forwarder que les événements >= ce niveau (INFO envoie tout, réduit le bruit avec WARN/CRITICAL)
SIEM_MIN_SEVERITY=INFO

# === OnlyOffice Docs Server (édition Word/Excel/PowerPoint) ===
# Le backend doit être joignable par le conteneur Docs.
# En Docker Compose, utiliser le nom du service (ex: "backend"), pas "localhost" ni "host.docker.internal".
ONLYOFFICE_ENABLED=true
# URL publique (vue par le navigateur) — sert via BunkerWeb sur /onlyoffice/
ONLYOFFICE_DOCUMENT_SERVER_URL=https://intranet.omnitech-security.fr/onlyoffice
ONLYOFFICE_INTERNAL_URL=http://backend:3000
# URL du Docs Server vue depuis le BACKEND (liste blanche anti-SSRF des URLs
# de téléchargement des callbacks). Défaut : http://localhost:8082
ONLYOFFICE_INTERNAL_DS_URL=http://localhost:8082
# Secret JWT partagé entre le backend et le Docs Server. Doit être défini et identique des deux côtés.
# Pour le désactiver en dev : définir JWT_ENABLED=false sur le conteneur Docs ET laisser vide ici.
ONLYOFFICE_JWT_SECRET=change-me-shared-secret-between-backend-and-docs
# Autoriser explicitement l'émission de configs NON signées (uniquement si le
# conteneur Docs a JWT_ENABLED=false). En prod : false.
ONLYOFFICE_ALLOW_UNSIGNED=false

# === Stirling PDF (outils PDF) ===
STIRLING_PDF_ENABLED=false
STIRLING_PDF_URL=http://localhost:8080

# === Data Retention (ISO 27001 A.5.33) ===
RETENTION_DOC_ARCHIVE_DAYS=1095     # 3 ans
RETENTION_DOC_DELETE_DAYS=2555      # 7 ans (RGPD)
RETENTION_AUDIT_KEEP_DAYS=1825      # 5 ans
RETENTION_AUTO_APPLY=false          # true pour activer la suppression automatique

# === Stirling PDF (suite d'outils PDF) ===
# Toggle the integration on/off. When disabled, the /stirling/* endpoints
# return a "disabled" status and the /tools/pdf page shows an info card.
STIRLING_PDF_ENABLED=false
# URL of the self-hosted Stirling PDF container (see STIRLING_SETUP.md).
STIRLING_PDF_URL=http://localhost:8080

# === RAG Pipeline (AI search / chatbot) ===
# Active le pipeline RAG synchrone (POST /rag/ask). REQUIS en production.
RAG_ENABLED=true
# Feature flag RBAC sur le retrieval RAG (ISO 27001 A.5.15).
RBAC_RAG_ENABLED=true
# Active embeddings semantiques + pgvector (P1.2). Necessite Ollama up + bge-m3.
RAG_SEMANTIC_ENABLED=false
# Mode de recherche : lexical | vector | hybrid (defaut : lexical).
RAG_HYBRID_MODE=lexical
# Seuil de similarite cosine (vector). En dessous, le chunk est rejete.
VECTOR_SIMILARITY_THRESHOLD=0.5

# === Item 30 — Optimisations pipeline RAG (Q2 2026) ===
# Toutes ces variables sont desactivees par defaut. Les activer une par une
# en mesurant l'impact via POST /rag/eval (admin) — voir docs/rag/EVALUATION.md.
#
# Cross-encoder reranker via Ollama. Necessite `ollama pull bge-reranker-v2-m3`.
# Reordonne le top-K du retrieval initial (K=20) en top-N (N=5) plus pertinent.
# Gain attendu : +0.05 a +0.15 MRR. Cout : ~50-150ms / query (CPU).
RAG_RERANKER_ENABLED=false
OLLAMA_RERANKER_MODEL=bge-reranker-v2-m3
RAG_RERANKER_TOP_K=20
RAG_RERANKER_TOP_N=5
RAG_RERANKER_TIMEOUT_MS=5000
#
# Hybrid retrieval BM25 + vector via Postgres tsvector + pgvector.
# Active le service `HybridSearchService` quand `RAG_HYBRID_MODE=hybrid`.
# Fusion : weighted (alpha) ou rrf. Avec rrf pas besoin de tuner alpha.
RAG_BM25_ENABLED=false
RAG_HYBRID_FUSION=weighted
RAG_HYBRID_ALPHA=0.7
#
# Query expansion via LLM (Mistral / phi3). Genere N reformulations cachees
# en Redis (TTL 1h). Robustesse aux paraphrases. Cout : 1 LLM call / query
# unique (cache miss). Gain attendu : +20% recall sur queries non-canoniques.
RAG_QUERY_EXPANSION_ENABLED=false
RAG_QUERY_EXPANSION_N=3
#
# Semantic chunking (structure-aware) au lieu de fixed-size 2000c/200c.
# Split sur titres Markdown / paragraphes / phrases FR. Necessite re-index.
# Gain attendu : +30% term coverage, meilleure granularite des snippets.
RAG_SEMANTIC_CHUNKING_ENABLED=false

# === Chatbot Unified Architecture (Mission 3) ===
# Active les endpoints unifiés /chat/* (sessions, ask-stream, feedback,
# regenerate, suggestions) et bascule le widget FAB sur le backend unifié.
# Laisser `false` tant que la Phase 2 (frontend refactor) n'est pas prête
# en prod : quand `false`, les endpoints /chat/* retournent 404 et le RAG
# actuel (POST /rag/ask-stream, RagQueryLog, etc.) reste seul actif.
CHATBOT_UNIFIED_ENABLED=false

# === Ollama (LLM local) ===
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:0.5b
OLLAMA_ENABLED=true
# Garde les modeles charges en RAM apres usage (defaut Ollama = 5m).
# A 30m, la majorite des sessions intranet evitent le cold-start
# (~14s sur bge-m3 + ~3s sur mistral). Cf. drop-in systemd dans
# docs/operations/ollama-keep-alive.conf.example.
# OLLAMA_KEEP_ALIVE=30m

# === RAG — Budget de generation (cf. fix 2026-06-12) ===
# Sur CPU (~8 tok/s sur mistral 7B), une reponse de 500 tokens prend ~60s,
# donc le defaut hardcode 500 tokens + 30s/modele de llm.service.ts ne tenait
# jamais (cascade systematique primary->fallback->emergency). On bornes les
# reponses RAG a une longueur realiste pour le CPU :
#   maxTokens 384 -> reponse concise mais complete (~50s gen en warm)
#   timeoutMs 90000 -> 1.5x marge sur la generation, permet au mistral de finir
# A ajuster a la hausse si la qualite des reponses semble tronquee, a la baisse
# si la latence frontend (cf. axios timeout 95s dans lib/api.ts) coupe les requetes.
RAG_ANSWER_MAX_TOKENS=384
RAG_ANSWER_TIMEOUT_MS=90000

# === Access Reviews (ISO 27001 A.5.18) ===
# Cron mensuel (1er du mois 03:00) qui cree automatiquement une campagne
# AccessReview de type INACTIVE_USERS si aucune n'est deja ACTIVE.
# Doit valoir EXACTEMENT "true" pour activer (securite : aucun side-effect par defaut).
ACCESS_REVIEW_AUTO_INACTIVE=false
# Seuil de rotation des mots de passe (en mois) utilise par les campagnes
# AccessReview de type PASSWORDS pour cibler les comptes "passwordChangedAt" obsoletes.
PASSWORD_ROTATION_MONTHS=6

# =====================================================================
# Wave D item 19 — HA Postgres / Patroni
# =====================================================================
# En architecture HA, le backend pointe sur la VIP keepalived (10.33.120.50)
# qui suit toujours le leader Patroni courant. Aucun changement code requis.
# Voir docs/infrastructure/HA_POSTGRES_PATRONI.md pour le setup 3 nœuds.
# DATABASE_URL=postgresql://omnitech:PASSWORD@10.33.120.50:5432/omnitech_intranet
#
# Mots de passe Patroni : NE JAMAIS commiter, déployer dans
# /etc/patroni/secrets.env (chmod 600 root:postgres) :
#   PATRONI_ADMIN_PASSWORD  (postgres superuser + patronictl)
#   PATRONI_REPL_PASSWORD   (compte replication interne)

# =====================================================================
# Wave D item 20 — Backup offsite chiffré (Restic + S3)
# =====================================================================
# Repo Restic — Scaleway Object Storage Paris recommandé (RGPD-friendly).
# Alternatives : OVH, Bunny.net, Wasabi EU. Cf. docs/infrastructure/BACKUP_RESTIC_OFFSITE.md
RESTIC_REPOSITORY=s3:s3.fr-par.scw.cloud/omnitech-backups-intranet

# Passphrase de chiffrement AES-256 du repo. À sauvegarder dans un coffre-fort
# équipe (Bitwarden) ET un coffre-fort hors-ligne. PERTE = backups irrécupérables.
# Générer : openssl rand -base64 32
RESTIC_PASSWORD=

# Credentials S3 — utiliser une IAM key WRITE-ONLY (pas DELETE) pour
# protéger les backups d'un attaquant qui aurait compromis ce serveur.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Identifiant de l'hôte source dans tous les snapshots
RESTIC_HOST=intranet-prod

# Politique de rétention GFS (defaults sains, override si besoin)
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=3

# Verify mensuel : taille du subset déchiffré pour test bit-rot (défaut 1G)
RESTIC_CHECK_SUBSET=1G

# Alertes échec backup (consommé par alerter@.service)
ALERT_EMAIL=ops@omnitech-security.fr
ALERT_WEBHOOK=

# Backup local (legacy item 20 conserve aussi les dumps locaux pour
# reprise rapide ; complémentaire au offsite). Path par défaut :
STORAGE_PATH=/var/omnitech/storage
